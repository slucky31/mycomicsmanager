<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Standalone tool — skip global analyzers that require web SDK context -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Same GC as the web app (ASP.NET Core uses Server GC), so memory figures match production. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Console progress output of a one-shot tool: synchronous writes are fine. -->
    <NoWarn>$(NoWarn);CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\Persistence\Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
