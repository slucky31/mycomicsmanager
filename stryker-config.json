{
  "stryker-config": {
    "test-runner": "mtp",
    "reporters": [ "progress", "html", "json", "markdown" ],
    "mutate": [
      "!**/Migrations/**/*.cs",
      "!**/*Error.cs",
      "!**/ApplicationDependencyInjection.cs",
      "!**/ApplicationDbContextFactory.cs"
    ],
    "ignore-methods": [ "Log*" ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    }
  }
}
