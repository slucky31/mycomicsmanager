{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "log/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "need_to_be_not_empty",
    "NeonConnectionUnitTests": "need_to_be_not_empty"
  },
  "Auth0": {
    "Domain": "domain",
    "ClientId": "client"
  },
  "LocalStorage": {
    "RootPath": "/tmp"
  },
  "Cloudinary": {
    "CloudName": "cloudname",
    "ApiKey": "apikey",
    "ApiSecret": "apisecret",
    "Folder": "folder"
  },
  "OpenLibrary": {
    "BaseUrl": "https://openlibrary.org",
    "CoversBaseUrl": "https://covers.openlibrary.org"
  },
  "GoogleBooks": {
    "BaseUrl": "https://www.googleapis.com/books/v1"
  },
  "Bedetheque": {
    "BaseUrl": "https://www.bedetheque.com",
    "SerpApiBaseUrl": "https://serpapi.com",
    "SerpApiKey": ""
  },
  "Import": {
    "ImportDirectory": "/data/import",
    "TempDirectory": "/data/temp",
    "ImageTargetWidth": 1400,
    "PollingIntervalSeconds": 30,
    "SupportedExtensions": [ ".cbz", ".cbr", ".zip", ".rar", ".pdf" ],
    "MaxFileSizeMb": 1024
  },
  "FeedImport": {
    "Enabled": false,
    "SyncIntervalMinutes": 30,
    "UserEmail": "",
    "TargetLibraryName": "À trier",
    "AllowedSourceHosts": [ "planete-bd.org", "zone-ebook.com" ],
    "AllowedDownloadHosts": [ "fileq.net", "dailyuploads.net", "frdl.io", "katfile.biz", "trbt.cc", "turbobit.net", "rapidgator.net", "1fichier.com" ]
  },
  "Miniflux": {
    "BaseUrl": "http://miniflux:8080",
    "ApiKey": "",
    "CategoryName": "BD"
  },
  "DebridLink": {
    "BaseUrl": "https://debrid-link.com/api/v2/",
    "ApiKey": "",
    "HosterPriority": [ "1fichier.com", "rapidgator.net", "turbobit.net", "trbt.cc", "katfile.biz", "dailyuploads.net", "fileq.net", "frdl.io" ],
    "DownloadHosts": [ "debrid.link", "debrid-link.com", "debrid-link.fr" ]
  }
}
