@using Web.Infrastructure

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" rel="stylesheet">
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@AppVersion.Versioned("css/theme.css")" />
    <link rel="stylesheet" href="@AppVersion.Versioned("mcm.Web.styles.css")" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MCM" />
    @* An opaque status bar above the app, in the colour of the pages (--mcm-surface-muted). When the app draws under it,
       iOS 26 and later blur the top of every page and nothing in the page can stop it (#1250). Keep "default":
       iOS reads it when the app is added to the Home Screen, so the app has to be added again after a change. *@
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#F4F4F6" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    @* The app added to the iPhone Home Screen (navigator.standalone): its pages start lower, out of the blur
       iOS draws under the status bar (--mcm-top-inset, theme.css, #1250). Set before the first paint. *@
    <script>if (navigator.standalone) { document.documentElement.classList.add('ios-standalone'); }</script>
    <HeadOutlet />
</head>

<body Style="background-color: #f5f5f5;">
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        window.bodyScroll = {
            disable: function () {
                document.documentElement.style.overflow = 'hidden';
                document.body.style.overflow = 'hidden';
            },
            enable: function () {
                document.documentElement.style.overflow = '';
                document.body.style.overflow = '';
            }
        };

        window.infiniteScroll = {
            _observer: null,
            observe: function (dotNetRef, sentinelId, scrollContainerSelector) {
                if (this._observer) { this._observer.disconnect(); }
                var sentinel = document.getElementById(sentinelId);
                if (!sentinel || !dotNetRef) return;
                var root = document.querySelector(scrollContainerSelector) || null;
                var self = this;
                this._observer = new IntersectionObserver(
                    function (entries) {
                        if (entries[0].isIntersecting) {
                            dotNetRef.invokeMethodAsync('LoadMoreBooksAsync');
                        }
                    },
                    { root: root, rootMargin: '300px', threshold: 0 }
                );
                this._observer.observe(sentinel);
            },
            dispose: function () {
                if (this._observer) {
                    this._observer.disconnect();
                    this._observer = null;
                }
            }
        };
    </script>
</body>

</html>
