@inherits LayoutComponentBase

<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.ExtraExtraLarge"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true" />

@if (_showNavigation)
{
    <NavBar />
}
<main class="page-body @(_showNavigation ? "with-nav" : string.Empty)">
    @Body
</main>
