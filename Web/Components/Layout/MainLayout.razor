@inherits LayoutComponentBase

<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* The dialogs of the redesign (AppDialogs) are styled from here: a sheet at the bottom of a phone, centered from the tablet on. *@
<div class="dialog-host">
    <MudDialogProvider FullWidth="true"
                       MaxWidth="MaxWidth.ExtraExtraLarge"
                       CloseButton="true"
                       BackdropClick="false"
                       NoHeader="false"
                       Position="DialogPosition.Center"
                       CloseOnEscapeKey="true" />
</div>

@* The rail and the side bar are always shown; only the bottom bar of a phone is hidden on focused tasks (NavigationRules). *@
<NavBar ShowBottomBar="_showBottomBar" />
<main class="page-body @(_showBottomBar ? "with-bottom-bar" : string.Empty)">
    @Body
</main>
