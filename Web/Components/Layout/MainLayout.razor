@inherits LayoutComponentBase

<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* The dialogs of the redesign (AppDialogs) are styled from here: a sheet at the bottom of a phone, centered from the tablet on. *@
<div class="dialog-host">
    <MudDialogProvider FullWidth="true"
                       MaxWidth="MaxWidth.ExtraExtraLarge"
                       CloseButton="true"
                       BackdropClick="false"
                       NoHeader="false"
                       Position="DialogPosition.Center"
                       CloseOnEscapeKey="true" />
</div>

@if (_showNavigation)
{
    <NavBar />
}
<main class="page-body @(_showNavigation ? "with-nav" : string.Empty)">
    @Body
</main>
