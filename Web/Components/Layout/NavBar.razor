@using Web.Components.SharedComponents

@* Tablet (rail) and desktop (side bar): one navigation, its width set by the screen width (NavBar.razor.css). *@
<nav class="side-nav" aria-label="Main">
    <a href="/libraries/list" class="side-nav-brand" aria-label="MyComicsManager, libraries">
        <img src="logo.png" alt="" width="40" height="40" class="side-nav-logo" />
        <span class="side-nav-title">MyComicsManager</span>
    </a>

    <a href="/libraries/list" class="side-nav-item @LibrariesEntryClass" aria-current="@AriaCurrent(IsLibrariesEntryActive)">
        <span class="side-nav-icon"><MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" /></span>
        <span class="side-nav-label">Libraries</span>
    </a>

    @if (_libraries.Count > 0)
    {
        <div class="side-nav-libraries">
            @foreach (var library in _libraries)
            {
                var isCurrent = library.Id == _currentLibraryId;
                <a href="@library.Href" class="@library.CssClass @ActiveClass(isCurrent)" aria-current="@AriaCurrent(isCurrent)" aria-label="@library.AriaLabel">
                    <MudIcon Icon="@LibraryIcons.Resolve(library.Icon)" Style="@($"color: {library.Color};")" Size="Size.Small" />
                    <span class="side-nav-library-name">@library.Name</span>
                    <span class="side-nav-library-count" aria-hidden="true">@library.CountLabel</span>
                </a>
            }
        </div>
    }

    <a href="/statistics" class="side-nav-item @ActiveClass(IsActive("/statistics"))" aria-current="@AriaCurrent(IsActive("/statistics"))">
        <span class="side-nav-icon"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></span>
        <span class="side-nav-label">Statistics</span>
    </a>
    <a href="/missing-volumes" class="side-nav-item @ActiveClass(IsActive("/missing-volumes"))" aria-current="@AriaCurrent(IsActive("/missing-volumes"))">
        <span class="side-nav-icon"><MudIcon Icon="@Icons.Material.Filled.PlaylistRemove" /></span>
        <span class="side-nav-label">Missing volumes</span>
    </a>
    <a href="/import" class="side-nav-item @ActiveClass(IsActive("/import"))" aria-current="@AriaCurrent(IsActive("/import"))">
        <span class="side-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Upload" /></span>
        <span class="side-nav-label">Import</span>
    </a>
    <a href="/feed-imports" class="side-nav-item @ActiveClass(IsActive("/feed-imports"))" aria-current="@AriaCurrent(IsActive("/feed-imports"))"
       aria-label="@FeedsLabel">
        <span class="side-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.RssFeed" />
            @if (_arbitrationCount > 0)
            {
                <span class="nav-badge" title="@ArbitrationBadgeLabel">@_arbitrationCount</span>
            }
        </span>
        <span class="side-nav-label">Feeds</span>
    </a>

    <span class="side-nav-spacer"></span>

    <a href="/settings" class="side-nav-item @ActiveClass(IsActive("/settings"))" aria-current="@AriaCurrent(IsActive("/settings"))">
        <span class="side-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Settings" /></span>
        <span class="side-nav-label">Settings</span>
    </a>
</nav>

@* Phone: bottom navigation. *@
<nav class="bottom-nav" aria-label="Main">
    <a href="/libraries/list" class="bottom-nav-item @LibrariesEntryClass" aria-current="@AriaCurrent(IsLibrariesEntryActive)">
        <span class="bottom-nav-icon"><MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" /></span>
        <span class="bottom-nav-label">Libraries</span>
    </a>
    <a href="/statistics" class="bottom-nav-item @ActiveClass(IsActive("/statistics"))" aria-current="@AriaCurrent(IsActive("/statistics"))">
        <span class="bottom-nav-icon"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></span>
        <span class="bottom-nav-label">Stats</span>
    </a>
    <a href="/import" class="bottom-nav-item @ActiveClass(IsActive("/import"))" aria-current="@AriaCurrent(IsActive("/import"))">
        <span class="bottom-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Upload" /></span>
        <span class="bottom-nav-label">Import</span>
    </a>
    <a href="/feed-imports" class="bottom-nav-item @ActiveClass(IsActive("/feed-imports"))" aria-current="@AriaCurrent(IsActive("/feed-imports"))"
       aria-label="@FeedsLabel">
        <span class="bottom-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.RssFeed" />
            @if (_arbitrationCount > 0)
            {
                <span class="nav-badge" title="@ArbitrationBadgeLabel">@_arbitrationCount</span>
            }
        </span>
        <span class="bottom-nav-label">Feeds</span>
    </a>
    <a href="/settings" class="bottom-nav-item @ActiveClass(IsActive("/settings"))" aria-current="@AriaCurrent(IsActive("/settings"))">
        <span class="bottom-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Settings" /></span>
        <span class="bottom-nav-label">Settings</span>
    </a>
</nav>
