@* A titled group of fields: one column on a phone, two from the tablet on. In the grid, .form-pair puts two fields side by side on a phone and .form-wide spans both columns. *@
<section class="form-section" aria-labelledby="@Id">
    <h2 id="@Id">@Title</h2>
    <div class="form-grid">@ChildContent</div>
</section>
