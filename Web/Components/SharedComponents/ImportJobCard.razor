@using Web.Models

<section class="@($"import-job {Job.StatusCssClass}")">
    <div class="import-job-head">
        <MudIcon Icon="@Icons.Material.Outlined.Description" Class="import-job-file-icon" />
        <div class="import-job-text">
            <div class="import-job-name" title="@Job.OriginalFileName">@Job.OriginalFileName</div>
            <div class="import-job-meta">@BookText.Join(Job.FileSizeDisplay, Job.CreatedAtDisplay, Job.DurationDisplay)</div>
        </div>
        <span class="import-job-status"><MudIcon Icon="@StatusIcon" />@Job.StatusDisplay</span>
    </div>

    @if (Job.StepDisplay is { } step)
    {
        <div class="import-job-progress" aria-hidden="true"><div class="import-job-progress-value" style="@($"width: {Job.ProgressPercent}%;")"></div></div>
        <div class="import-job-step">@BookText.Join(step, Job.ConversionDetail)</div>
    }

    @if (Job.FailureDisplay is { } failure)
    {
        <div class="import-job-error">@failure</div>
        @if (Job.FailedStepDisplay is { } failedStep)
        {
            <div class="import-job-error-step">@failedStep</div>
        }
    }

    @if (Job.BookHref is not null || Job.FileHref is not null || HasActions)
    {
        <div class="import-job-actions">
            @if (Job.BookHref is { } href)
            {
                <a class="import-job-link" href="@href">Open the book</a>
            }
            <span class="import-job-actions-spacer"></span>
            @if (IsStuck && OnForceFail.HasDelegate)
            {
                <MudTooltip Text="Mark as failed (stuck import)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Cancel"
                                   OnClick="@(() => OnForceFail.InvokeAsync(Job.Id))"
                                   aria-label="Mark this import as failed" />
                </MudTooltip>
            }
            @if (Job.FileHref is { } fileHref)
            {
                <MudTooltip Text="Download the file">
                    <MudIconButton Icon="@Icons.Material.Outlined.Download"
                                   Href="@fileHref"
                                   download
                                   aria-label="Download the file of this import" />
                </MudTooltip>
            }
            @if (Job.IsFailed && OnAbandon.HasDelegate)
            {
                <MudTooltip Text="Abandon (deletes the file)">
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteForever"
                                   OnClick="@(() => OnAbandon.InvokeAsync(Job))"
                                   aria-label="Abandon this import and delete its file" />
                </MudTooltip>
            }
            @if (Job.IsFailed && OnRetry.HasDelegate)
            {
                <MudTooltip Text="Retry">
                    <MudIconButton Icon="@Icons.Material.Outlined.Replay"
                                   OnClick="@(() => OnRetry.InvokeAsync(Job.Id))"
                                   aria-label="Retry this import" />
                </MudTooltip>
            }
            @if (Job.IsCompleted && OnDelete.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               OnClick="@(() => OnDelete.InvokeAsync(Job.Id))"
                               aria-label="Delete this import" />
            }
        </div>
    }
</section>
