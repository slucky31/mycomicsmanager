@* The bar of a form page (ADR-0021): back, what the form is about, and its actions from the tablet on. *@
<header class="form-bar">
    @if (OnBack.HasDelegate)
    {
        <button type="button" class="form-bar-back" aria-label="Back" title="Back" @onclick="OnBack"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></button>
    }
    else
    {
        <a class="form-bar-back" href="@BackHref" aria-label="Back" title="Back"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></a>
    }
    <div class="form-bar-heading">
        <h1>@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="form-bar-subtitle">@Subtitle</div>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="form-bar-actions">@ChildContent</div>
    }
</header>
