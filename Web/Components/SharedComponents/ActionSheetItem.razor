@if (Href is not null)
{
    <a class="@CssClass" href="@Href">
        <MudIcon Icon="@Icon" Class="action-sheet-item-icon" />
        <span class="action-sheet-item-text">@Text</span>
    </a>
}
else
{
    <button type="button" class="@CssClass" aria-pressed="@AriaPressed" disabled="@Disabled" @onclick="OnClick">
        <MudIcon Icon="@Icon" Class="action-sheet-item-icon" />
        <span class="action-sheet-item-text">
            @Text
            @if (!string.IsNullOrEmpty(Description))
            {
                <span class="action-sheet-item-description">@Description</span>
            }
        </span>
        @if (Selected == true)
        {
            <MudIcon Icon="@Icons.Material.Filled.Check" Class="action-sheet-item-check" />
        }
    </button>
}
