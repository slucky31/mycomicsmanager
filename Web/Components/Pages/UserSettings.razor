@page "/settings"

@using Web.Infrastructure
@using Web.Models

<PageTitle>Settings — MyComicsManager</PageTitle>

<div class="settings-page">
    <header class="settings-bar">
        <h1>Settings</h1>
    </header>

    <div class="settings-content">
        <section class="settings-card settings-account" aria-label="Account">
            @if (!string.IsNullOrEmpty(_picture))
            {
                <img class="settings-avatar" src="@_picture" alt="" />
            }
            else
            {
                <span class="settings-avatar" aria-hidden="true">@AccountViewModel.Initials(_username, _email)</span>
            }
            <div class="settings-account-text">
                <div class="settings-account-name">@_username</div>
                <div class="settings-account-email">@_email</div>
            </div>
        </section>

        <section class="settings-card settings-list">
            @* The version in the key recreates the switch after a save, so a refused change shows the actual setting again. *@
            <label @key="_hiddenVersion" class="settings-row settings-hidden-libraries">
                <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="settings-row-icon" />
                <span class="settings-row-text">
                    <span class="settings-row-label">Show hidden libraries</span>
                    <span id="settings-hidden-libraries-help" class="settings-row-help">Hidden libraries and their books are shown everywhere, dimmed.</span>
                </span>
                <input type="checkbox" role="switch" class="settings-switch-input" checked="@_showHiddenLibraries" disabled="@(_isLoadingHidden || _isSavingHidden)"
                       aria-describedby="settings-hidden-libraries-help" @onchange="@(args => SetShowHiddenLibrariesAsync(args.Value is true))" />
                <span class="settings-switch" aria-hidden="true"><span class="settings-switch-thumb"></span></span>
            </label>
            <button type="button" class="settings-row" aria-expanded="@(_showHealthDetail ? "true" : "false")" aria-controls="settings-health-detail"
                    @onclick="ToggleHealthDetail">
                <MudIcon Icon="@Icons.Material.Outlined.MonitorHeart" Class="settings-row-icon" />
                <span class="settings-row-text">System health</span>
                @if (_isLoadingHealth)
                {
                    <span class="settings-health-chip">Checking…</span>
                }
                else
                {
                    <span class="@($"settings-health-chip {SystemHealthViewModel.CssClass(_health.Tone)}")">
                        <MudIcon Icon="@(_health.Tone == HealthTone.Healthy ? Icons.Material.Filled.Check : Icons.Material.Filled.PriorityHigh)" />
                        @_health.Summary
                    </span>
                }
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="@($"settings-row-end settings-health-chevron{(_showHealthDetail ? " expanded" : "")}")" />
            </button>
            @if (_showHealthDetail)
            {
                <ul id="settings-health-detail" class="settings-health-detail">
                    @if (_health.Checks.Count == 0)
                    {
                        <li class="settings-health-empty">Health status unavailable</li>
                    }
                    @foreach (var check in _health.Checks)
                    {
                        <li class="settings-health-check">
                            <span class="settings-health-name">@check.Name</span>
                            <span class="@($"settings-health-chip {SystemHealthViewModel.CssClass(check.Tone)}")">@check.Status</span>
                        </li>
                    }
                </ul>
            }
            <div class="settings-row">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Class="settings-row-icon" />
                <span class="settings-row-text">Version</span>
                <span class="settings-row-value app-version">@AppVersion.Current</span>
            </div>
            <a class="settings-row settings-sign-out" href="/Account/Logout">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Class="settings-row-icon" />
                <span class="settings-row-text">Sign out</span>
            </a>
        </section>

        <AuthorizeView Roles="Admin">
            <section class="settings-card administration">
                <h2 class="settings-section-title">Administration</h2>
                <a class="settings-row" href="/admin/log-levels">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="settings-row-icon" />
                    <span class="settings-row-text">Log levels</span>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="settings-row-end" />
                </a>
                @* Hangfire is served outside Blazor: open it as a regular page, not through the Blazor router *@
                <a class="settings-row" href="/hangfire" target="_blank" rel="noopener" aria-label="Hangfire (opens in a new tab)">
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Class="settings-row-icon" />
                    <span class="settings-row-text">Hangfire</span>
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="settings-row-end" />
                </a>
                <Web.Components.Pages.Admin.FeatureTogglesCard />
                <Web.Components.Pages.Admin.LegacyMigrationCard />
                <Web.Components.Pages.Admin.ComicInfoSyncCard />
                <Web.Components.Pages.Admin.ArchiveRefreshCard />
            </section>
        </AuthorizeView>
    </div>
</div>
