@page "/books/add/form"
@rendermode InteractiveServer

@using Web.Components.SharedComponents
@using Web.Models
@using Web.Validators

<PageTitle>@PageTitleText — MyComicsManager</PageTitle>

<FormPage>
    @if (_isLoading)
    {
        <FormHeader Title="Looking up the book" Subtitle="@($"ISBN {Isbn}")" BackHref="@ExitHref" />
        <FormState Loading="true" Text="Looking for this ISBN in the catalogues…" />
    }
    else if (_step == AddBookStep.Found && _found is not null)
    {
        var found = _found;
        <FormHeader Title="Book found" Subtitle="@found.IsbnLabel" BackHref="@ExitHref" />
        <div class="found-body">
            <div class="found-card">
                <div class="found-book">
                    @if (!string.IsNullOrEmpty(found.ImageLink))
                    {
                        <img class="found-cover" src="@found.ImageLink" alt="@found.CoverAlt" />
                    }
                    else
                    {
                        <div class="found-cover found-cover-none" role="img" aria-label="No cover"><MudIcon Icon="@Icons.Material.Filled.MenuBook" /></div>
                    }
                    <div class="found-info">
                        <h2 class="found-title">@found.Title</h2>
                        @if (found.SerieAndVolume is not null)
                        {
                            <div class="found-serie">@found.SerieAndVolume</div>
                        }
                        @if (found.Authors is not null)
                        {
                            <div class="found-line">@found.Authors</div>
                        }
                        @if (found.Publication is not null)
                        {
                            <div class="found-line">@found.Publication</div>
                        }
                        @if (found.SourceLabel is not null)
                        {
                            <div class="found-source"><MudIcon Icon="@Icons.Material.Outlined.Info" />@found.SourceLabel</div>
                        }
                    </div>
                </div>

                <LibrarySelect Libraries="_libraries" Value="_model.LibraryId" ValueChanged="ChooseLibrary" Error="@_errors.For(nameof(BookUiDto.LibraryId))" />

                <div class="found-rating">
                    <div id="found-rating-title" class="found-rating-title">Already read it?</div>
                    <div class="found-rating-hint">Rate it to add a reading date (optional).</div>
                    <StarRating Value="_model.Rating" ValueChanged="ChooseRating" LabelledBy="found-rating-title" />
                </div>

                <div class="found-actions">
                    <FormButton Icon="@Icons.Material.Filled.Add" Disabled="_isSaving" OnClick="SaveAsync">@AddToLabel</FormButton>
                    <FormButton Variant="FormButtonVariant.Text" OnClick="EditDetails">Edit details before adding</FormButton>
                </div>
            </div>
        </div>
    }
    else
    {
        <FormHeader Title="Add a book" Subtitle="@FormSubtitle" BackHref="@ExitHref" OnBack="@(_found is null ? default : EventCallback.Factory.Create(this, ShowFound))">
            <FormButton Variant="FormButtonVariant.Outlined" Href="@ExitHref">Cancel</FormButton>
            <FormButton Type="submit" Form="add-book-form" Icon="@Icons.Material.Filled.Add" Disabled="_isSaving">Add book</FormButton>
        </FormHeader>

        <BookFormLayout FormId="add-book-form" OnSubmit="SaveAsync" Errors="_errors" ImageLink="@_model.ImageLink">
            <Side>
                <LibrarySelect Libraries="_libraries" Value="_model.LibraryId" ValueChanged="ChooseLibrary" Error="@_errors.For(nameof(BookUiDto.LibraryId))" />
            </Side>
            <ChildContent>
                <BookFields Model="_model" Errors="_errors" OnChanged="Revalidate" />
            </ChildContent>
            <Footer>
                <FormFooter>
                    <FormButton Variant="FormButtonVariant.Outlined" Href="@ExitHref">Cancel</FormButton>
                    <FormButton Type="submit" Icon="@Icons.Material.Filled.Add" Disabled="_isSaving">Add book</FormButton>
                </FormFooter>
            </Footer>
        </BookFormLayout>
    }
</FormPage>
