@page "/books/{BookId}/find-details"
@rendermode InteractiveServer

@using Application.Helpers
@using Application.Interfaces
@using Web.Models
@using Web.Services
@using Web.Validators

<div class="find-details-page">

    @* ── Header ── *@
    <PageHeader Title="Find book details" OnBack="Cancel" />

    @* ── Body ── *@
    <div class="find-details-content">
        @if (_isLoading)
        {
            <div class="d-flex flex-column align-center justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">Loading…</MudText>
            </div>
        }
        else if (_loadError || _currentBook is null)
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" Style="font-size: 80px; opacity: 0.5;" />
                <MudText Typo="Typo.h6" Color="Color.Error" Class="mt-4">Book not found</MudText>
                <MudButton Class="mt-4" OnClick="Cancel">Go Back</MudButton>
            </MudPaper>
        }
        else
        {

                RenderFragment SourceOption(BookSource source, string label, string? value) =>
                @<MudRadio T="BookSource" Value="@source" Dense="true" Disabled="@(value is null)">
                    <div class="find-details-option">
                        <span class="find-details-source-label">@label</span>
                        @SearchStateIcon(source)
                        <span class="find-details-source-value">@(value ?? "—")</span>
                    </div>
                </MudRadio>;

                // Every web source shows where its search stands; the current values have none.
                RenderFragment SearchStateIcon(BookSource source) =>
                @<span class="find-details-source-state">
                    @if (_searchStates.TryGetValue(source, out var state))
                    {
                        var label = ProviderSearchStateDisplay.Label(state, SourceName(source));
                        <MudTooltip Text="@label">
                            <MudIcon Icon="@ProviderSearchStateDisplay.Icon(state)"
                                     Color="@ProviderSearchStateDisplay.Color(state)"
                                     Size="Size.Small"
                                     Class="@(state == ProviderSearchState.Searching ? "find-details-state-searching" : null)"
                                     aria-label="@label" />
                        </MudTooltip>
                    }
                </span>;


            <div class="find-details-fields">

                @* SEARCH PROGRESS *@
                @if (_searchStates.Count > 0)
                {
                    <div class="find-details-search-status" role="status" aria-live="polite">
                        <div class="find-details-search-summary">
                            @if (IsSearching)
                            {
                                <MudText Typo="Typo.body2">Searching the sources… (@SearchesDone/@_searchStates.Count)</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2">Search complete</MudText>
                            }
                        </div>
                        <div class="find-details-search-sources">
                            @foreach (var source in _searchStates.Keys)
                            {
                                <span class="find-details-search-source">
                                    @SearchStateIcon(source)
                                    @SourceName(source)
                                </span>
                            }
                        </div>
                        @if (IsSearching)
                        {
                            <MudProgressLinear Color="Color.Primary" Value="@(100.0 * SearchesDone / _searchStates.Count)" Size="Size.Small" Rounded="true" />
                        }
                    </div>
                }

                @if (_isbnFromPage)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        ISBN <b>@_isbn</b> read on the book's page will be saved with the book@(string.IsNullOrWhiteSpace(_currentBook.ISBN) ? "." : $", in place of {_currentBook.ISBN}.")
                    </MudAlert>
                }

                @* TITLE *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">TITLE</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedTitle" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      _currentBook.Title)
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.Title))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.Title))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.Title))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.Title))
                    </MudRadioGroup>
                </div>

                @* SERIE *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">SERIE</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedSerie" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      NullIfEmpty(_currentBook.Serie))
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.Serie))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.Serie))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.Serie))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.Serie))
                    </MudRadioGroup>
                </div>

                @* VOLUME NUMBER *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">VOLUME NUMBER</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedVolumeNumber" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      _currentBook.VolumeNumber.ToString())
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.VolumeNumber))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.VolumeNumber))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.VolumeNumber))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.VolumeNumber))
                    </MudRadioGroup>
                </div>

                @* AUTHORS *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">AUTHORS</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedAuthors" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      NullIfEmpty(_currentBook.Authors))
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.Authors))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.Authors))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.Authors))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.Authors))
                    </MudRadioGroup>
                </div>

                @* PUBLISHERS *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">PUBLISHERS</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedPublishers" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      NullIfEmpty(_currentBook.Publishers))
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.Publishers))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.Publishers))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.Publishers))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.Publishers))
                    </MudRadioGroup>
                </div>

                @* PUBLISH DATE *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">PUBLISH DATE</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedPublishDate" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      _currentBook.PublishDate?.ToString(PublishDateHelper.DisplayFormat))
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.PublishDate))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.PublishDate))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.PublishDate))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.PublishDate))
                    </MudRadioGroup>
                </div>

                @* NUMBER OF PAGES *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">NUMBER OF PAGES</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedNumberOfPages" Class="find-details-radio-group">
                        @SourceOption(BookSource.Current,     "CURRENT",      _currentBook.NumberOfPages?.ToString())
                        @SourceOption(BookSource.Bnf,         "BNF",          GetBnfValue(BookFieldKeys.NumberOfPages))
                        @if (BedethequeService.IsEnabled)
                        {
                            @SourceOption(BookSource.Bedetheque,  "BEDETHEQUE",   GetBedethequeValue(BookFieldKeys.NumberOfPages))
                        }
                        @SourceOption(BookSource.OpenLibrary, "OPENLIBRARY",  GetOlValue(BookFieldKeys.NumberOfPages))
                        @SourceOption(BookSource.Google,      "GOOGLE BOOKS", GetGoogleValue(BookFieldKeys.NumberOfPages))
                    </MudRadioGroup>
                </div>

                @* COVER IMAGE *@
                <div class="find-details-field-card">
                    <div class="find-details-field-label">COVER IMAGE</div>
                    <MudRadioGroup T="BookSource" @bind-Value="_selectedCover" Class="find-details-radio-group">
                        <MudRadio T="BookSource" Value="BookSource.Current" Dense="true">
                            <div class="find-details-option">
                                <span class="find-details-source-label">CURRENT</span>
                                @if (!string.IsNullOrEmpty(_currentBook.ImageLink))
                                {
                                    <img src="@_currentBook.ImageLink" class="find-details-cover-thumb" alt="current cover" />
                                }
                                else
                                {
                                    <span class="find-details-source-value">—</span>
                                }
                            </div>
                        </MudRadio>
                        @if (BedethequeService.IsEnabled)
                        {
                            <MudRadio T="BookSource" Value="BookSource.Bedetheque" Dense="true" Disabled="@(_bedethequeResult?.CoverUrl is null)">
                                <div class="find-details-option">
                                    <span class="find-details-source-label">BEDETHEQUE</span>
                                    @SearchStateIcon(BookSource.Bedetheque)
                                    @if (_bedethequeResult?.CoverUrl is not null)
                                    {
                                        <img src="@_bedethequeResult.CoverUrl" class="find-details-cover-thumb" alt="bedetheque cover" />
                                    }
                                    else
                                    {
                                        <span class="find-details-source-value">—</span>
                                    }
                                </div>
                            </MudRadio>
                        }
                        <MudRadio T="BookSource" Value="BookSource.OpenLibrary" Dense="true" Disabled="@(_olResult?.CoverUrl is null)">
                            <div class="find-details-option">
                                <span class="find-details-source-label">OPENLIBRARY</span>
                                @SearchStateIcon(BookSource.OpenLibrary)
                                @if (_olResult?.CoverUrl is not null)
                                {
                                    <img src="@_olResult.CoverUrl" class="find-details-cover-thumb" alt="openlibrary cover" />
                                }
                                else
                                {
                                    <span class="find-details-source-value">—</span>
                                }
                            </div>
                        </MudRadio>
                        <MudRadio T="BookSource" Value="BookSource.Google" Dense="true" Disabled="@(_googleResult?.CoverUrl is null)">
                            <div class="find-details-option">
                                <span class="find-details-source-label">GOOGLE BOOKS</span>
                                @SearchStateIcon(BookSource.Google)
                                @if (_googleResult?.CoverUrl is not null)
                                {
                                    <img src="@_googleResult.CoverUrl" class="find-details-cover-thumb" alt="google cover" />
                                }
                                else
                                {
                                    <span class="find-details-source-value">—</span>
                                }
                            </div>
                        </MudRadio>
                    </MudRadioGroup>
                </div>

            </div>

            @* ── Actions ── *@
            <div class="find-details-actions">
                <MudButton Variant="Variant.Text"
                           OnClick="Cancel"
                           Disabled="_isSaving">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="ApplyAndSaveAsync"
                           Disabled="_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Apply &amp; Save
                </MudButton>
            </div>
        }
    </div>
</div>
