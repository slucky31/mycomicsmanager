@page "/books/{BookId}/find-details"
@rendermode InteractiveServer

@using Web.Models

<PageTitle>Import info from the web — MyComicsManager</PageTitle>

<div class="find-details-page">

    <header class="find-details-bar">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel" aria-label="Back" Class="find-details-back" />
        <div class="find-details-bar-title">
            <h1>Import info from the web</h1>
            @if (_currentBook is not null)
            {
                <div class="find-details-bar-subtitle">@BookText.Join(_currentBook.Title, BookText.SerieAndVolume(_currentBook.Serie, _currentBook.Title, _currentBook.VolumeNumber))</div>
            }
        </div>
    </header>

    <div class="find-details-content">
        @if (_isLoading)
        {
            <div class="find-details-loading">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <span>Loading…</span>
            </div>
        }
        else if (_loadError || _currentBook is null)
        {
            <div class="find-details-card find-details-not-found">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
                <div>
                    <strong>Book not found</strong>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Cancel">Go back</MudButton>
                </div>
            </div>
        }
        else if (IsTextSearch)
        {
            <form class="find-details-card find-details-query" @onsubmit="SearchByTextAsync">
                <div class="find-details-query-hint">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    <span>This book has no ISBN. Search the sources by title, series and volume, then pick the matching edition.</span>
                </div>
                <div class="find-details-query-fields">
                    <MudTextField T="string" @bind-Value="_queryTitle" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="find-details-query-title" />
                    <MudTextField T="string" @bind-Value="_querySerie" Label="Series" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="find-details-query-serie" />
                    <MudNumericField T="int?" @bind-Value="_queryVolume" Label="Volume" Min="0" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="find-details-query-volume" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@(IsTextSearching || TextQuery.IsEmpty)" Class="find-details-query-search">Search</MudButton>
                </div>
                <div role="status" aria-live="polite">
                    @if (_textSearchStates.Count == 0)
                    {
                        <span class="find-details-muted">No web source is turned on (Settings → Features).</span>
                    }
                    else if (IsTextSearching)
                    {
                        <span>Searching the sources… (@TextSearchesDone/@_textSearchStates.Count)</span>
                        <MudProgressLinear Color="Color.Primary" Value="@(100.0 * TextSearchesDone / _textSearchStates.Count)" Rounded="true" Class="find-details-progress" />
                    }
                    else
                    {
                        <span class="find-details-muted">Pick the edition of the book, then compare it with the book.</span>
                    }
                </div>
            </form>

            @foreach (var (source, state) in _textSearchStates)
            {
                var candidates = CandidatesOf(source);
                var headingId = $"find-details-editions-{source}";
                <section @key="source" class="find-details-card find-details-editions" aria-labelledby="@headingId">
                    <h2 id="@headingId" class="find-details-editions-title">
                        <span>@BookSources.Name(source)</span>
                        <span class="find-details-muted">@BookCandidateDisplay.Summary(state, candidates.Count)</span>
                    </h2>
                    @if (candidates.Count > 0)
                    {
                        <div class="find-details-editions-list" role="radiogroup" aria-labelledby="@headingId">
                            @foreach (var candidate in candidates)
                            {
                                var chosen = IsChosen(source, candidate);
                                <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")"
                                        class="@($"find-details-option find-details-edition{(chosen ? " selected" : "")}")"
                                        disabled="@(candidate.Isbn is null)"
                                        @onclick="() => Choose(source, candidate)">
                                    @if (candidate.CoverUrl is not null)
                                    {
                                        <img class="find-details-cover" src="@candidate.CoverUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="find-details-cover find-details-cover-none"><MudIcon Icon="@Icons.Material.Outlined.MenuBook" /></span>
                                    }
                                    <span class="find-details-option-text">
                                        <span class="find-details-edition-title">@candidate.Title</span>
                                        @if (BookCandidateDisplay.SerieAndVolume(candidate) is { } serieAndVolume)
                                        {
                                            <span class="find-details-muted">@serieAndVolume</span>
                                        }
                                        @if (BookCandidateDisplay.Edition(candidate) is { } edition)
                                        {
                                            <span class="find-details-muted">@edition</span>
                                        }
                                        <span class="find-details-edition-isbn">@BookCandidateDisplay.Isbn(candidate)</span>
                                    </span>
                                    @if (chosen)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Class="find-details-option-check" />
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        }
        else
        {
            <div class="find-details-card find-details-status" role="status" aria-live="polite">
                @if (_searchStates.Count == 0)
                {
                    <span>No web source is turned on (Settings → Features).</span>
                }
                else if (IsSearching)
                {
                    <span>Searching the sources… (@SearchesDone/@_searchStates.Count)</span>
                    <MudProgressLinear Color="Color.Primary" Value="@(100.0 * SearchesDone / _searchStates.Count)" Rounded="true" Class="find-details-progress" />
                }
                else if (NoSourceFound)
                {
                    <strong>No source found this book.</strong>
                }
                else if (_comparison.Differences.Count > 0)
                {
                    <strong>@_comparison.DifferencesSummary</strong> <span class="find-details-muted">Pick the value to keep for each.</span>
                }
                else
                {
                    <strong>@_comparison.DifferencesSummary</strong> <span class="find-details-muted">The book already has the values found on the web.</span>
                }
            </div>

            @if (_edition is { } picked)
            {
                <div class="find-details-card find-details-isbn">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    <span class="find-details-picked">Edition picked on @BookSources.Name(picked.Source): <strong>@picked.Candidate.Title</strong>@(BookCandidateDisplay.Edition(picked.Candidate) is { } pickedEdition ? $" ({pickedEdition})" : string.Empty). Its ISBN <strong>@_isbn</strong> will be saved with the book.</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ChangeEdition" Class="find-details-change-edition">Change edition</MudButton>
                </div>
            }
            else if (IsbnFromPage)
            {
                <div class="find-details-card find-details-isbn">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    <span>ISBN <strong>@_isbn</strong> read on the book's page will be saved with the book@(string.IsNullOrWhiteSpace(_currentBook.ISBN) ? "." : $", in place of {_currentBook.ISBN}.")</span>
                </div>
            }

            @foreach (var comparison in _comparison.Differences)
            {
                var field = comparison.Field;
                var labelId = $"find-details-{field.Key}";
                <div @key="field.Key" class="find-details-field" role="radiogroup" aria-labelledby="@labelId">
                    <div id="@labelId" class="find-details-field-label">@field.Label</div>
                    <div class="find-details-options">
                        @foreach (var option in comparison.Options)
                        {
                            var selected = IsSelected(field.Key, option);
                            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                                    class="@($"find-details-option{(selected ? " selected" : "")}")"
                                    @onclick="() => Select(field.Key, option.Source)">
                                <span class="find-details-option-text">
                                    <span class="find-details-option-source">@option.SourcesLabel</span>
                                    @if (field.IsImage && option.Value is not null)
                                    {
                                        <img class="find-details-cover" src="@option.Value" alt="@($"Cover from {option.SourcesLabel}")" />
                                    }
                                    else
                                    {
                                        <span class="find-details-option-value">@(option.Value ?? "—")</span>
                                    }
                                </span>
                                @if (selected)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Class="find-details-option-check" />
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_comparison.MatchSummary is { } matchSummary)
            {
                <div class="find-details-match">
                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                    <span>@matchSummary</span>
                </div>
            }

            @if (_searchStates.Count > 0)
            {
                <div class="find-details-sources">
                    <span>@(IsSearching ? "Sources:" : "Sources checked:")</span>
                    @foreach (var (source, state) in _searchStates)
                    {
                        var label = ProviderSearchStateDisplay.Label(state, BookSources.Name(source));
                        <span class="find-details-source" title="@label">
                            <MudIcon Icon="@ProviderSearchStateDisplay.Icon(state)" Color="@ProviderSearchStateDisplay.Color(state)"
                                     Class="@(state == ProviderSearchState.Searching ? "find-details-state-searching" : null)" aria-label="@label" />
                            @BookSources.Name(source)
                        </span>
                    }
                </div>
            }
        }
    </div>

    @if (!_isLoading && !_loadError && _currentBook is not null)
    {
        <div class="find-details-actions">
            <MudButton Variant="Variant.Outlined" OnClick="Cancel" Disabled="_isSaving" Class="find-details-cancel">Cancel</MudButton>
            @if (IsTextSearch)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompareWithEditionAsync"
                           Disabled="@(_chosen is null || _isCheckingIsbn)" Class="find-details-apply find-details-compare">
                    @if (_isCheckingIsbn)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Compare with this edition
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyAndSaveAsync"
                           Disabled="@(_isSaving || _changeCount == 0)" Class="find-details-apply">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @BookDetailsComparison.ApplyLabel(_changeCount)
                </MudButton>
            }
        </div>
    }
</div>
