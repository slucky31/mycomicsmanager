@using Web.Components.SharedComponents
@using Web.Models
@using Web.Validators

@* The fields of a book, in its "Book" and "Details" sections (A6, E1, T8, T11): to add a book and to edit one. *@
<FormSection Id="book-form-book" Title="Book">
    @TextField("book-title", "Title", nameof(BookUiDto.Title), Model.Title, v => Model.Title = v, RequiredField)
    @TextField("book-serie", "Series", nameof(BookUiDto.Serie), Model.Serie, v => Model.Serie = v, RequiredField)
    <div class="form-pair">
        @TextField("book-isbn", "ISBN", nameof(BookUiDto.ISBN), Model.ISBN, v => Model.ISBN = v, IsbnField)
        <FormField Id="book-volume" Label="Volume" Error="@Errors.For(nameof(BookUiDto.VolumeNumber))">
            <input id="book-volume" type="number" inputmode="numeric" min="1" @bind="Model.VolumeNumber" @bind:after="NotifyChangedAsync"
                   aria-invalid="@Errors.AriaInvalid(nameof(BookUiDto.VolumeNumber))" aria-describedby="@Describe("book-volume", nameof(BookUiDto.VolumeNumber))" />
        </FormField>
    </div>
</FormSection>

<FormSection Id="book-form-details" Title="Details">
    @TextField("book-authors", "Authors", nameof(BookUiDto.Authors), Model.Authors, v => Model.Authors = v, new() { Placeholder = "e.g. Daniel Warren Johnson", Help = "Separate several names with commas" })
    @TextField("book-publishers", "Publisher", nameof(BookUiDto.Publishers), Model.Publishers, v => Model.Publishers = v, new() { Placeholder = "e.g. Delcourt" })
    <FormField Id="book-published" Label="Publish date" Error="@Errors.For(nameof(BookUiDto.PublishDate))">
        <input id="book-published" type="date" @bind="Model.PublishDate" @bind:after="NotifyChangedAsync"
               aria-invalid="@Errors.AriaInvalid(nameof(BookUiDto.PublishDate))" aria-describedby="@Describe("book-published", nameof(BookUiDto.PublishDate))" />
    </FormField>
    <FormField Id="book-pages" Label="Pages" Error="@Errors.For(nameof(BookUiDto.NumberOfPages))">
        <input id="book-pages" type="number" inputmode="numeric" min="1" placeholder="e.g. 271" @bind="Model.NumberOfPages" @bind:after="NotifyChangedAsync"
               aria-invalid="@Errors.AriaInvalid(nameof(BookUiDto.NumberOfPages))" aria-describedby="@Describe("book-pages", nameof(BookUiDto.NumberOfPages))" />
    </FormField>
    <div class="form-wide">
        @TextField("book-cover", "Cover image URL", nameof(BookUiDto.ImageLink), Model.ImageLink, v => Model.ImageLink = v, new() { Placeholder = "https://…", Type = "url" })
    </div>
</FormSection>

@code {
    // How a text field looks and what it accepts.
    private sealed record FieldOptions
    {
        public bool Required { get; init; }
        public string? Placeholder { get; init; }
        public string? Help { get; init; }
        public string Type { get; init; } = "text";
        public string? InputMode { get; init; }
    }

    private static readonly FieldOptions RequiredField = new() { Required = true };

    // A digital book may have no ISBN.
    private FieldOptions IsbnField => new() { Required = Model.IsPhysical, InputMode = "numeric" };

    // A text field of the form: its label above, its error and help under it.
    private RenderFragment TextField(string id, string label, string property, string? value, Action<string> setValue, FieldOptions? options = null) => __builder =>
    {
        var field = options ?? new FieldOptions();
        <FormField Id="@id" Label="@label" Required="@field.Required" Error="@Errors.For(property)" Help="@field.Help">
            <input id="@id" type="@field.Type" inputmode="@field.InputMode" placeholder="@field.Placeholder" value="@value"
                   @oninput="args => OnInputAsync(setValue, args)"
                   aria-invalid="@Errors.AriaInvalid(property)" aria-describedby="@FormFieldIds.DescribedBy(id, Errors.For(property), field.Help)" />
        </FormField>
    };
}
