@page "/books/{BookId}/edit"
@rendermode InteractiveServer

@using Web.Components.SharedComponents
@using Web.Models

<PageTitle>Edit book — MyComicsManager</PageTitle>

<FormPage>
    @if (_isLoading)
    {
        <FormHeader Title="Edit book" Subtitle="Loading…" BackHref="@BookHref" />
        <FormState Loading="true" Text="Loading the book…" />
    }
    else if (_view is null || _model is null)
    {
        <FormHeader Title="Edit book" BackHref="/libraries/list" />
        <FormState Icon="@Icons.Material.Outlined.MenuBook" Title="Book not found" Text="This book does not exist or could not be loaded.">
            <FormButton Variant="FormButtonVariant.Outlined" Href="/libraries/list" Icon="@Icons.Material.Filled.ArrowBack">Back to libraries</FormButton>
        </FormState>
    }
    else
    {
        var view = _view;
        <FormHeader Title="Edit book" Subtitle="@view.Subtitle" BackHref="@BookHref">
            <FormButton Variant="FormButtonVariant.Outlined" Href="@BookHref">Cancel</FormButton>
            <FormButton Type="submit" Form="edit-book-form" Icon="@Icons.Material.Filled.Check" Disabled="_isSaving">Save changes</FormButton>
        </FormHeader>

        <BookFormLayout FormId="edit-book-form" OnSubmit="SaveAsync" Errors="_errors" ImageLink="@_model.ImageLink">
            <Side>
                <div class="edit-library">
                    @if (!string.IsNullOrWhiteSpace(_model.ImageLink))
                    {
                        <img class="edit-library-cover" src="@CoverImage.Sized(_model.ImageLink, CoverSize.Small)" alt="@view.CoverAlt" loading="lazy" />
                    }
                    <div class="edit-library-text">
                        <div class="edit-library-caption">Library</div>
                        <div class="edit-library-name">@view.LibraryLabel(_libraryName)</div>
                        <div class="edit-library-hint">To move the book, use “Move to another library” on its page.</div>
                    </div>
                </div>
            </Side>
            <ChildContent>
                <BookFields Model="_model" Errors="_errors" OnChanged="Revalidate" />

                <FormSection Id="book-form-readings" Title="Readings" Note="@view.ReadingsCountLabel">
                    <div class="form-wide edit-readings">
                        @if (view.Readings.Count > 0)
                        {
                            <ul>
                                @foreach (var reading in view.Readings)
                                {
                                    <li @key="reading.Id" class="edit-reading">
                                        <div class="edit-reading-text">
                                            <div class="edit-reading-date">@reading.Date</div>
                                            <StarRating Value="reading.Rating" ReadOnly="true" />
                                        </div>
                                        <button type="button" class="edit-reading-delete" aria-label="@reading.DeleteLabel" title="Delete this reading"
                                                disabled="@(_deletingReadingId is not null)" @onclick="() => DeleteReadingAsync(reading)">
                                            <MudIcon Icon="@Icons.Material.Outlined.Delete" />
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="edit-readings-empty">No readings recorded</div>
                        }
                        <div class="edit-readings-hint">New readings are added from the book’s page.</div>
                    </div>
                </FormSection>
            </ChildContent>
            <Footer>
                <FormFooter>
                    <FormButton Variant="FormButtonVariant.Outlined" Href="@BookHref">Cancel</FormButton>
                    <FormButton Type="submit" Icon="@Icons.Material.Filled.Check" Disabled="_isSaving">Save changes</FormButton>
                </FormFooter>
            </Footer>
        </BookFormLayout>
    }
</FormPage>
