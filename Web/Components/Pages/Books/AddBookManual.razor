@page "/books/add/manual"
@rendermode InteractiveServer

@using Web.Components.SharedComponents
@using Web.Models

<PageTitle>Type the ISBN — MyComicsManager</PageTitle>

<div class="add-page">
    <AddBookHeader Title="Type the ISBN" Subtitle="@(_libraryName is null ? null : $"Adding to {_libraryName}")" BackHref="@AddBookLinks.Exit(_libraryId)" />

    <form class="isbn-form" novalidate @onsubmit="LookUp">
        <FormField Id="@InputId" Label="ISBN" Error="@_error" Help="@IsbnEntry.Help">
            <input @ref="_input" id="@InputId" class="isbn-input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false"
                   placeholder="978-2-413-01540-6" @bind="_isbn" @bind:event="oninput" @bind:after="ClearError"
                   aria-invalid="@(_error is null ? null : "true")" aria-describedby="@FormFieldIds.DescribedBy(InputId, _error, IsbnEntry.Help)" />
        </FormField>
        <button type="submit" class="isbn-look-up"><MudIcon Icon="@Icons.Material.Filled.Search" />Look up</button>
    </form>
</div>
