@page "/books/{BookId}"
@rendermode InteractiveServer

@using Domain.Books
@using Web.Components.SharedComponents
@using Web.Models

<PageTitle>@(_view?.Title ?? "Book") — MyComicsManager</PageTitle>

<div class="book-page">
    <header class="book-bar">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" aria-label="Back to library" Class="book-bar-back" />
        <nav class="book-bar-trail" aria-label="Breadcrumb">
            @if (_view is not null)
            {
                <a href="@_view.LibraryHref">@(_libraryName ?? "Library")</a><span class="book-bar-trail-current"> / <span aria-current="page">@_view.Title</span></span>
            }
        </nav>
        @if (_view is not null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@_view.EditHref" aria-label="Edit book" Class="book-bar-edit-icon" />
            <MudButton StartIcon="@Icons.Material.Filled.Edit" Href="@_view.EditHref" Variant="Variant.Outlined" Class="book-bar-edit">Edit</MudButton>
            <MudIconButton id="@ActionsButtonId" Icon="@Icons.Material.Filled.MoreVert" OnClick="OpenActionsAsync" aria-label="More actions" Class="book-bar-more" />
        }
    </header>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-flex mx-auto mt-8" />
    }
    else if (_view is null)
    {
        <div class="book-not-found">
            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
            <h1>Book not found</h1>
            <p>The book you're looking for doesn't exist.</p>
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Filled" Color="Color.Primary" OnClick="GoBack">Back to Books</MudButton>
        </div>
    }
    else
    {
        var view = _view;
        <div class="book-body">
            <div class="book-side">
                @if (!string.IsNullOrEmpty(view.ImageLink))
                {
                    <img class="book-cover" src="@CoverImage.Sized(view.ImageLink, CoverSize.Large)" alt="@view.CoverAlt" />
                }
                else
                {
                    <div class="book-cover book-cover-none" role="img" aria-label="No cover">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                    </div>
                }

                <div class="book-primary">
                    @if (view.IsDigital)
                    {
                        <a class="book-primary-button" href="@view.ReadHref">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                            <span class="book-primary-text">
                                @view.ReadLabel
                                @if (view.ReadProgressLabel is not null)
                                {
                                    <span class="book-primary-progress">@view.ReadProgressLabel</span>
                                }
                            </span>
                        </a>
                        @if (view.CanStartOver)
                        {
                            <div class="book-progress-row">
                                @if (view.ReadProgressPercent is { } percent)
                                {
                                    <div class="book-progress" aria-hidden="true"><div style="@($"width: {percent}%;")"></div></div>
                                }
                                <button type="button" class="book-start-over" disabled="@_isStartingOver" @onclick="StartOverAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.RestartAlt" />Start over
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <button type="button" class="book-primary-button book-primary-outlined" @onclick="ShowAddReading">
                            <MudIcon Icon="@Icons.Material.Filled.Add" />
                            <span class="book-primary-text">Add a reading</span>
                        </button>
                    }
                </div>
            </div>

            <div class="book-main">
                <div class="book-heading">
                    <h1>@view.Title</h1>
                    @if (view.SerieAndVolume is not null)
                    {
                        <div class="book-serie">@view.SerieAndVolume</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(view.Authors))
                    {
                        <div class="book-authors">@view.Authors</div>
                    }
                    <div class="book-status">
                        @if (view.FormatLabel is not null)
                        {
                            <span class="book-format">@view.FormatLabel</span>
                        }
                        @if (view.LatestRating > 0)
                        {
                            @Stars(view.LatestRating, view.LatestRatingLabel)
                        }
                        @if (view.HasBeenRead)
                        {
                            <span class="book-read"><MudIcon Icon="@Icons.Material.Filled.Check" />Read</span>
                        }
                    </div>
                </div>

                <div class="book-actions">
                    <a class="book-action" href="@view.FindDetailsHref"><MudIcon Icon="@Icons.Material.Filled.CloudDownload" />Import info</a>
                    @if (view.IsDigital)
                    {
                        <button type="button" class="book-action" @onclick="FindIsbn"><MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" />Find ISBN</button>
                        <a class="book-action" href="@view.DownloadHref" download><MudIcon Icon="@Icons.Material.Filled.Download" />CBZ</a>
                    }
                    <button type="button" class="book-action" disabled="@_isMoving" @onclick="MoveBookAsync"><MudIcon Icon="@Icons.Material.Filled.DriveFileMove" />Move</button>
                </div>

                <div class="book-panels">
                    <section class="book-panel book-details" aria-labelledby="book-details-title">
                        <h2 id="book-details-title">Details</h2>
                        <dl>
                            <div>
                                <dt>ISBN</dt>
                                <dd class="book-isbn-value">
                                    <IsbnScanStateIcon State="@view.IsbnScanState" CandidateCount="@view.IsbnCandidates.Count" Isbn="@view.Isbn" HideWhenKnown="@(view.Isbn is null)" Size="Size.Small" />
                                    <span class="book-isbn">@(view.Isbn ?? "None")</span>
                                </dd>
                            </div>
                            @foreach (var field in view.Details)
                            {
                                <div>
                                    <dt>@field.Label</dt>
                                    <dd><span>@field.Value</span></dd>
                                </div>
                            }
                        </dl>

                        @* Search of the ISBN printed on the pages, while the book has none *@
                        @if (view.IsbnScanState == IsbnScanState.Candidates)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                                <MudText Typo="Typo.body2">Several ISBNs are printed in this book. Pick its own to fetch its information:</MudText>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @foreach (var isbn in view.IsbnCandidates)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.TravelExplore" Style="font-family: monospace;"
                                                   OnClick="@(() => UseIsbnCandidate(isbn))">
                                            @isbn
                                        </MudButton>
                                    }
                                </div>
                            </MudAlert>
                        }
                        else if (view.IsbnScanNotice is not null)
                        {
                            <MudAlert Severity="Severity.Normal" Dense="true" Icon="@IsbnScanStateDisplay.Icon(view.IsbnScanState)" Class="mt-4 book-isbn-scan">
                                <MudText Typo="Typo.body2">@view.IsbnScanNotice</MudText>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.DocumentScanner"
                                               Disabled="_isScanningIsbn" OnClick="ScanIsbnAsync">
                                        @if (_isScanningIsbn)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        }
                                        @view.ScanIsbnLabel
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.MenuBook" OnClick="FindIsbn">
                                        Look in the reader
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </section>

                    <section class="book-panel book-history" aria-labelledby="book-history-title">
                        <h2 id="book-history-title">Reading history</h2>
                        @if (view.Readings.Count > 0)
                        {
                            <ul>
                                @foreach (var reading in view.Readings)
                                {
                                    <li>
                                        <span class="book-history-date">@reading.Date</span>
                                        @Stars(reading.Rating, reading.RatingLabel)
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="book-history-empty">Not read yet</div>
                        }

                        @if (_showAddReading)
                        {
                            <div class="book-reading-form" role="group" aria-labelledby="book-reading-form-title">
                                <div id="book-reading-form-title" class="book-reading-form-title">Add a reading · today</div>
                                <div class="book-reading-stars">
                                    @for (var rating = 1; rating <= 5; rating++)
                                    {
                                        var value = rating;
                                        <button type="button" class="@(value <= _newRating ? "book-star-button book-star-on" : "book-star-button")"
                                                aria-label="@(value == 1 ? "1 star" : $"{value} stars")" aria-pressed="@(value == _newRating ? "true" : "false")"
                                                @onclick="() => _newRating = value">
                                            <MudIcon Icon="@(value <= _newRating ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" />
                                        </button>
                                    }
                                </div>
                                <div class="book-reading-buttons">
                                    <button type="button" class="book-reading-cancel" @onclick="CancelAddReading">Cancel</button>
                                    <button type="button" class="book-reading-save" disabled="@(_newRating == 0 || _isAddingReading)" @onclick="AddReadingDateAsync">Save</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="book-history-add" @onclick="ShowAddReading"><MudIcon Icon="@Icons.Material.Filled.Add" />Add a reading</button>
                        }
                    </section>
                </div>
            </div>
        </div>

        <ActionSheet Open="_actionsOpen" AriaLabel="@view.ActionsLabel" Anchor="@_sheetAnchor" AlignEnd="true" OnClose="CloseActions">
            <Header>
                <div class="book-sheet-header">
                    @if (!string.IsNullOrEmpty(view.ImageLink))
                    {
                        <img src="@CoverImage.Sized(view.ImageLink, CoverSize.ExtraSmall)" alt="" loading="lazy" />
                    }
                    <div class="book-sheet-heading">
                        <div class="book-sheet-title">@view.Title</div>
                        <div class="book-sheet-details">@view.ActionsDetails</div>
                    </div>
                </div>
            </Header>
            <ChildContent>
                <ActionSheetItem Icon="@Icons.Material.Filled.Edit" Text="Edit" Href="@view.EditHref" />
                <ActionSheetItem Icon="@Icons.Material.Filled.CloudDownload" Text="Import info from the web" Href="@view.FindDetailsHref" />
                <ActionSheetItem Icon="@Icons.Material.Filled.DriveFileMove" Text="Move to another library" Disabled="_isMoving" OnClick="MoveFromActionsAsync" />
                <div class="action-sheet-divider"></div>
                <ActionSheetItem Icon="@Icons.Material.Filled.Delete" Text="Delete" Danger="true" OnClick="DeleteFromActionsAsync" />
            </ChildContent>
        </ActionSheet>
    }
</div>

@code {
    // Five stars, read only: the rating of a reading.
    private static RenderFragment Stars(int rating, string label) => __builder =>
    {
        <span class="book-stars" role="img" aria-label="@label">
            @for (var star = 1; star <= 5; star++)
            {
                <MudIcon Icon="@(star <= rating ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" Class="@(star <= rating ? "book-star book-star-on" : "book-star")" />
            }
        </span>
    };
}
