@page "/books/{BookId}/read"
@layout ScannerLayout
@rendermode InteractiveServer

<PageTitle>@(_info is null ? "Reader" : _info.Title)</PageTitle>

<div class="book-reader">
    @if (_isLoading)
    {
        <div class="reader-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_info is null)
    {
        <div class="reader-center">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h6" Class="mt-4">This book cannot be read</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Filled" Color="Color.Primary"
                       Class="mt-4" OnClick="CloseAsync">
                Back to book
            </MudButton>
        </div>
    }
    else
    {
        <div class="@ScrollerClass" data-layout="@ScriptOptions.Key" @ref="_scroller">
            <div class="reader-pages">
                @foreach (var row in DisplayedRows)
                {
                    @* One element per row and page, kept across renders: only the images are added, so the scroll position holds. *@
                    <div class="reader-row" data-row="@row">
                        @foreach (var pageIndex in _spreads!.PagesOf(row))
                        {
                            var isRequested = _pages.IsRequested(pageIndex);
                            <div class="@(isRequested ? "reader-page" : "reader-page reader-page-pending")" data-page="@pageIndex">
                                @if (isRequested)
                                {
                                    <img src="@PageUrl(pageIndex)" alt="@($"Page {pageIndex + 1}")" class="reader-page-image" />
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Page by page, only the page shown is in the document: the next ones are loaded in advance. *@
        @foreach (var pageIndex in PreloadedPages)
        {
            <img src="@PageUrl(pageIndex)" alt="" class="reader-preload" aria-hidden="true" />
        }

        @if (_showControls)
        {
            <header class="reader-toolbar reader-toolbar-top">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="CloseAsync" aria-label="Close reader" />
                <MudText Typo="Typo.subtitle1" Class="reader-title">@ReaderDisplay.Title(_info.Serie, _info.Title)</MudText>
                @if (IsIsbnSearch)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="reader-mode">ISBN search · progress not saved</MudChip>
                }
                @if (IsRightToLeft)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="reader-mode reader-direction">Right to left</MudChip>
                }
                <MudSpacer />
                @if (_isExtractingIsbn)
                {
                    @if (_scanProgress is not null)
                    {
                        <MudText Typo="Typo.body2" Class="reader-counter">Page @_scanProgress</MudText>
                    }
                    <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Size="Size.Small" Class="mx-3" aria-label="Reading the page" />
                }
                else if (IsIsbnSearch)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ManageSearch" Color="Color.Inherit" OnClick="ScanIsbnPagesAsync"
                                   aria-label="Scan the first and last pages" title="Scan the first and last pages" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.ChromeReaderMode" Color="Color.Inherit" OnClick="OpenDisplayPanel"
                               aria-label="Display" title="Display" />
                @if (_canUseFullscreen)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Inherit" OnClick="ToggleFullscreenAsync"
                                   aria-label="Full screen" title="Full screen (F)" />
                }
                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Inherit" AriaLabel="More actions"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.DocumentScanner" Disabled="@_isExtractingIsbn" OnClick="ExtractIsbnAsync">
                        Find the ISBN on this page
                    </MudMenuItem>
                </MudMenu>
            </header>

            @if (_quickPages.Count > 0)
            {
                <nav class="reader-quick-pages" aria-label="First and last pages">
                    @for (var i = 0; i < _quickPages.Count; i++)
                    {
                        var pageIndex = _quickPages[i];
                        @if (i > 0 && pageIndex > _quickPages[i - 1] + 1)
                        {
                            <span class="reader-quick-gap" aria-hidden="true">…</span>
                        }
                        <MudButton Size="Size.Small" Color="Color.Inherit"
                                   Variant="@(pageIndex == _currentPage ? Variant.Filled : Variant.Outlined)"
                                   Class="reader-quick-page" OnClick="@(() => GoToPageAsync(pageIndex))"
                                   aria-label="@($"Go to page {pageIndex + 1}")">
                            @(pageIndex + 1)
                        </MudButton>
                    }
                </nav>
            }

            <footer class="reader-toolbar reader-toolbar-bottom">
                @* Mangas: the next page is on the left, and the slider fills from the right. *@
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit"
                               Disabled="@(!IsRightToLeft && IsFirstRow)" OnClick="LeftArrowAsync"
                               aria-label="@(IsRightToLeft ? "Next page" : "Previous page")" />
                <div class="reader-slider" dir="@(IsRightToLeft ? "rtl" : "ltr")">
                    <MudSlider T="int" Min="1" Max="@_info.PageCount" Value="@(_currentPage + 1)"
                               ValueChanged="OnSliderChangedAsync" Immediate="false" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.body2" Class="reader-counter">@_spreads!.Counter(_currentRow)</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Inherit"
                               Disabled="@(IsRightToLeft && IsFirstRow)" OnClick="RightArrowAsync"
                               aria-label="@(IsRightToLeft ? "Previous page" : "Next page")" />
            </footer>
        }
        else
        {
            <div class="reader-progress" aria-hidden="true">
                <div class="reader-progress-value" style="width: @ReaderDisplay.ProgressWidth(_currentPage, _info.PageCount)"></div>
            </div>
        }

        @if (_showDisplayPanel)
        {
            <div class="reader-panel-backdrop" @onclick="CloseDisplayPanel"></div>
            <section class="reader-panel" aria-label="Display">
                <div class="reader-panel-header">
                    <MudText Typo="Typo.h6">Display</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDisplayPanel" aria-label="Close the display settings" />
                </div>
                <MudText Typo="Typo.overline" Class="reader-panel-label">Layout</MudText>
                <div class="reader-options" role="group" aria-label="Layout">
                    @foreach (var option in s_layoutOptions)
                    {
                        var selected = option.Value == _settings.Layout;
                        <button type="button" class="@OptionClass(selected)" aria-pressed="@(selected ? "true" : "false")"
                                @onclick="() => ChangeLayoutAsync(option.Value)">
                            <MudIcon Icon="@option.Icon" Size="Size.Small" />
                            <span>@option.Label</span>
                        </button>
                    }
                </div>
                <MudText Typo="Typo.overline" Class="reader-panel-label">Scrolling</MudText>
                <div class="reader-options" role="group" aria-label="Scrolling">
                    @foreach (var option in s_scrollingOptions)
                    {
                        var selected = option.Value == _settings.Scrolling;
                        <button type="button" class="@OptionClass(selected)" aria-pressed="@(selected ? "true" : "false")"
                                @onclick="() => ChangeScrollingAsync(option.Value)">
                            <MudIcon Icon="@option.Icon" Size="Size.Small" />
                            <span>@option.Label</span>
                        </button>
                    }
                </div>
                <MudText Typo="Typo.overline" Class="reader-panel-label">Reading direction</MudText>
                <div class="reader-options" role="group" aria-label="Reading direction">
                    @foreach (var option in s_directionOptions)
                    {
                        var selected = option.Value == _settings.Direction;
                        <button type="button" class="@OptionClass(selected)" aria-pressed="@(selected ? "true" : "false")"
                                @onclick="() => ChangeDirectionAsync(option.Value)">
                            <MudIcon Icon="@option.Icon" Size="Size.Small" />
                            <span>@option.Label</span>
                        </button>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="reader-panel-note">Saved for this book.</MudText>
            </section>
        }

        @if (_showGestureHelp)
        {
            <div class="reader-help" role="dialog" aria-modal="true" aria-label="How to read">
                <div class="reader-help-zones">
                    <div class="reader-help-zone">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" />
                        <span>@(IsRightToLeft ? "Next" : "Previous")</span>
                    </div>
                    <div class="reader-help-zone reader-help-zone-center">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" />
                        <span>Show or hide the controls</span>
                    </div>
                    <div class="reader-help-zone">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" />
                        <span>@(IsRightToLeft ? "Previous" : "Next")</span>
                    </div>
                </div>
                <div class="reader-help-footer">
                    <MudText Typo="Typo.body1">@(IsPaged ? "Swipe sideways to turn the page." : "You can also scroll freely with your finger.")</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DismissGestureHelpAsync">Got it</MudButton>
                </div>
            </div>
        }

        @if (_showFinish)
        {
            <div class="reader-overlay">
                <MudPaper Class="pa-6 rounded-lg d-flex flex-column align-center gap-3" Elevation="8">
                    <MudText Typo="Typo.h6">You finished this book</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Rate it to add a reading date.</MudText>
                    <MudRating @bind-SelectedValue="_rating" MaxValue="5" Size="Size.Large" />
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Variant="Variant.Text" OnClick="CloseFinish">Keep reading</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@_isMarkingAsRead" OnClick="MarkAsReadAsync">
                            Mark as read
                        </MudButton>
                    </div>
                </MudPaper>
            </div>
        }

        @if (_isbnCandidates.Count > 0)
        {
            <div class="reader-overlay">
                <MudPaper Class="pa-6 rounded-lg d-flex flex-column align-center gap-3" Elevation="8">
                    <MudText Typo="Typo.h6">@(_isbnCandidates.Count == 1 ? "ISBN found on this page" : "ISBNs found on this page")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Select it to fetch the information of the book.</MudText>
                    @foreach (var isbn in _isbnCandidates)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TravelExplore"
                                   Class="reader-isbn" OnClick="@(() => FetchBookInfoAsync(isbn))">
                            @isbn
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Text" Class="mt-2" OnClick="CloseIsbnCandidates">Cancel</MudButton>
                </MudPaper>
            </div>
        }
    }
</div>
