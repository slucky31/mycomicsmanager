<h2 class="feature-toggles-title">Features</h2>
<p class="feature-toggles-hint">
    A change applies immediately and is kept across restarts. Set back to its configured value, a feature follows the configuration again.
</p>

<div class="feature-toggles">
    @foreach (var toggle in _toggles)
    {
        @* The version in the key recreates the switch after a save, so a refused change shows its actual state again. *@
        <label @key="(toggle.Toggle, _version)" class="feature-toggle">
            <span class="feature-toggle-text">
                <span class="feature-toggle-label">@toggle.Label</span>
                <span class="feature-toggle-description">@toggle.Description</span>
                <span class="feature-toggle-configuration">
                    @toggle.ConfigurationDisplay
                    @if (toggle.IsOverridden)
                    {
                        <span class="feature-toggle-overridden">overridden</span>
                    }
                </span>
            </span>
            <input type="checkbox" role="switch" class="feature-toggle-input" checked="@toggle.Enabled" disabled="@_isSaving"
                   aria-label="@toggle.Label" @onchange="@(args => SetAsync(toggle.Toggle, args.Value is true))" />
            <span class="feature-toggle-switch" aria-hidden="true"><span class="feature-toggle-thumb"></span></span>
        </label>
    }
</div>
