@page "/admin/log-levels"
@attribute [Authorize(Roles = "Admin")]
@using Web.Infrastructure

<PageTitle>Log levels — MyComicsManager</PageTitle>

<div class="log-levels-page">
    <header class="log-levels-bar">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/settings" aria-label="Back to settings" Class="log-levels-back" />
        <h1>Log levels</h1>
    </header>

    <div class="log-levels-content">
        <p class="log-levels-hint">
            A change applies immediately and lasts until the next restart; a logger without a level of its own
            (<em>inherited</em>) follows its parent namespace.
        </p>

        <div class="log-levels-toolbar">
            <label class="log-levels-filter">
                <MudIcon Icon="@Icons.Material.Filled.Search" />
                <input type="search" placeholder="Filter, e.g. Web.Services" aria-label="Filter the loggers"
                       @bind="_filter" @bind:event="oninput" />
            </label>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAll" Class="log-levels-reset">
                Reset
            </MudButton>
        </div>

        @{
            var shown = _loggers.Where(MatchesFilter).ToList();
        }
        <div class="log-levels-count">
            @(shown.Count == _loggers.Count ? $"{_loggers.Count} loggers" : $"{shown.Count} of {_loggers.Count} loggers")
        </div>

        @if (shown.Count == 0)
        {
            <div class="log-levels-empty">No logger matches the filter.</div>
        }
        else
        {
            <ul class="log-levels-list">
                @foreach (var logger in shown)
                {
                    <li @key="logger.Name" class="logger">
                        <div class="logger-head">
                            <span class="logger-name">@logger.Name</span>
                            @if (logger.ConfiguredLevel is null)
                            {
                                <span class="logger-inherited">inherited</span>
                            }
                            else if (logger.Name != LogLevelSwitches.RootLoggerName)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Class="logger-inherit"
                                               title="Inherit the level of the parent namespace"
                                               aria-label="@($"Inherit the level of the parent namespace for {logger.Name}")"
                                               OnClick="() => SetLevel(logger.Name, null)" />
                            }
                        </div>
                        <div class="logger-levels" role="group" aria-label="@($"Level of {logger.Name}")">
                            @foreach (var option in s_levels)
                            {
                                var isCurrent = logger.EffectiveLevel == option.Level;
                                <button type="button" class="@($"logger-level {option.CssClass}")"
                                        aria-pressed="@(isCurrent ? "true" : "false")"
                                        @onclick="() => SetLevel(logger.Name, option.Level)">
                                    @option.Label
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
