@* The library to move a book, or several books of a library (#1150), to (E6, T14): a row per library, the current one shown but not chosen, then "Move to …". *@
<MudDialog Class="app-dialog app-dialog-wide" ContentClass="app-dialog-content" aria-labelledby="@TitleId">
    <DialogContent>
        <div class="app-dialog-handle" aria-hidden="true"></div>
        <div class="move-heading">
            <div class="move-heading-text">
                <h2 id="@TitleId">@MudDialog.Title</h2>
                <p class="move-intro">
                    @if (Choices.CurrentName is { } current)
                    {
                        <text>@Choices.Subject <strong>@current</strong>. @Choices.FileNote</text>
                    }
                    else
                    {
                        <text>@Choices.FileNote</text>
                    }
                </p>
            </div>
            <button type="button" class="move-close" aria-label="Close" title="Close" @onclick="Cancel"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
        </div>

        <div class="move-libraries" role="radiogroup" aria-labelledby="@TitleId">
            @foreach (var library in Choices.Libraries)
            {
                var selected = library.Id == _selected?.Id;
                <button @key="library.Id" type="button" role="radio" aria-checked="@(selected ? "true" : "false")" disabled="@library.IsCurrent"
                        class="@(selected ? "move-library move-library-selected" : "move-library")" @onclick="() => Choose(library)">
                    <LibraryIcon Icon="@library.Icon" Color="@library.Color" Large="true" />
                    <span class="move-library-text">
                        <span class="move-library-heading">
                            <span class="move-library-name">@library.Name</span>
                            @if (library.IsSuggested)
                            {
                                <span class="move-library-suggested">Suggested</span>
                            }
                        </span>
                        <span class="move-library-details">@library.Details</span>
                    </span>
                    <span class="@(selected ? "move-library-radio move-library-radio-on" : "move-library-radio")" aria-hidden="true">
                        @if (selected)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" />
                        }
                    </span>
                </button>
            }
        </div>

        <div class="move-actions">
            <button type="button" class="move-button move-cancel" @onclick="Cancel">Cancel</button>
            <button type="button" class="move-button move-confirm" disabled="@(_selected is null)" @onclick="Confirm">
                <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" />@(_selected?.MoveLabel ?? "Move")
            </button>
        </div>
    </DialogContent>
</MudDialog>
