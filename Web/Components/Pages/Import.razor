@rendermode InteractiveServer

@page "/import"

@using Web.Components.Pages.Books
@using Web.Components.SharedComponents
@using Web.Models

<PageTitle>Import — MyComicsManager</PageTitle>

<div class="import-page">
    <header class="import-bar">
        <h1>Import</h1>
        <div class="import-bar-subtitle">Comic files into a digital library</div>
    </header>

    <div class="import-content">
        @if (_loadError is not null)
        {
            <div class="import-card import-error" role="alert">@_loadError</div>
        }
        else if (_digitalLibraries.Count == 0)
        {
            <div class="import-card import-empty">
                <span>No digital library yet. Create one to import comic files.</span>
                <a class="import-link" href="/libraries/add">New library</a>
            </div>
        }
        else
        {
            <LibrarySelect Id="import-library" Libraries="_digitalLibraries" Value="_selectedLibraryId" ValueChanged="OnLibraryChangedAsync" />

            @* No drag and drop: a phone has nothing to drop, the button works everywhere. *@
            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           Accept=".cbz,.cbr,.zip,.rar,.pdf"
                           FilesChanged="OnFilesSelectedAsync"
                           Disabled="@(_selectedLibraryId == Guid.Empty || _isUploading)"
                           MaximumFileCount="10"
                           Class="import-upload">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(_isUploading ? null : Icons.Material.Filled.Upload)"
                               Disabled="@(_selectedLibraryId == Guid.Empty || _isUploading)"
                               Class="import-choose"
                               OnClick="@upload.OpenFilePickerAsync">
                        @if (_isUploading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Uploading…</span>
                        }
                        else
                        {
                            <span>Choose files</span>
                        }
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
            <div class="import-hint">CBZ, CBR, ZIP, RAR, PDF · up to 10 files</div>

            @foreach (var error in _uploadErrors)
            {
                <div class="import-card import-error" role="alert">@error</div>
            }

            @if (_isLoadingJobs)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_jobs.Count > 0)
            {
                <div class="import-section-head">
                    <h2>In progress and recent</h2>
                    <span>@(_jobs.Count == 1 ? "1 file" : $"{_jobs.Count} files")</span>
                    <MudTooltip Text="Clear finished imports">
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep"
                                       Size="Size.Small"
                                       Disabled="@(_isDeletingTerminal || !_jobs.Any(j => j.IsTerminal))"
                                       OnClick="DeleteTerminalJobsAsync"
                                       aria-label="Clear finished imports" />
                    </MudTooltip>
                </div>
                <div class="import-jobs">
                    @foreach (var job in _jobs)
                    {
                        <ImportJobCard @key="job.Id" Job="@job" OnDelete="DeleteJobAsync" OnForceFail="ForceFailJobAsync" />
                    }
                </div>
            }
            else if (_selectedLibraryId != Guid.Empty)
            {
                <div class="import-none">No import in this library yet.</div>
            }
        }
    </div>
</div>
