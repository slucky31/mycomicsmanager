@rendermode InteractiveServer

@page "/libraries/{LibraryId}"

@using Domain.Libraries
@using Web.Components.Pages.Libraries.Views
@using Web.Components.SharedComponents
@using Web.Enums
@using Web.Models

<PageTitle>@(_library?.Name ?? "Library") — MyComicsManager</PageTitle>

<div class="library-detail-page">
    @if (_library is not null)
    {
        <header class="@(_isSearchOpen ? "library-bar library-bar-searching" : "library-bar")">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" aria-label="Back to libraries" Class="library-bar-back" />
            <div class="library-bar-title">
                <h1>@_library.Name</h1>
                <div class="library-bar-subtitle">
                    @LibraryDisplay.Subtitle(_libraryBookCount, _currentSortOrder)<span class="library-bar-view"> · @LibraryDisplay.ViewLabel(_currentViewMode)</span>
                </div>
            </div>
            <div class="library-search">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="CloseSearch" aria-label="Close search" Class="library-search-close" />
                <label class="library-search-field">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="library-search-icon" />
                    <input @ref="_searchInput" type="search" placeholder="Search by title or series" aria-label="Search by title or series"
                           @bind="SearchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(SearchTerm))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClearSearch" aria-label="Clear search" />
                    }
                </label>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="OpenSearch" aria-label="Search" Class="library-bar-search" />
            <MudIconButton id="@SortAndViewButtonId" Icon="@Icons.Material.Filled.Tune" OnClick="OpenSortAndViewAsync" aria-label="Sort and view" Class="library-bar-action" />
            @if (IsDigital)
            {
                <MudIconButton id="@MoreActionsButtonId" Icon="@Icons.Material.Filled.MoreHoriz" OnClick="OpenMoreActionsAsync" aria-label="More actions" Class="library-bar-action" />
            }
            else
            {
                <MudIconButton id="@AddBookIconId" Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenAddBookAsync" aria-label="New book" aria-haspopup="dialog" Class="library-bar-add" />
                <MudButton id="@AddBookButtonId" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddBookAsync" aria-haspopup="dialog" Class="library-bar-new-book">New book</MudButton>
            }
        </header>

        @if (!string.IsNullOrEmpty(_shownSearch) && _displayedBooks.Count > 0)
        {
            <div class="library-search-results" role="status">@LibraryDisplay.SearchResults(_resultCount, _shownSearch)</div>
        }
    }

    <div @ref="_content" class="library-detail-content">
        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-flex mx-auto mt-8" />
        }
        else if (_displayedBooks.Count == 0 && string.IsNullOrEmpty(_shownSearch))
        {
            <div class="library-empty">
                <MudIcon Icon="@IconPicker.Resolve(_library?.Icon)" Style="@($"color: {_library?.Color}; font-size: 80px; opacity: 0.4;")" />
                <MudText Typo="Typo.h6" Class="mt-4">No books in this library yet</MudText>
                @if (IsDigital)
                {
                    <MudText Typo="Typo.body2" Class="library-empty-hint">Start by importing your first ebook</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Variant="Variant.Filled" Color="Color.Primary" OnClick="NavigateToImport">Import</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="library-empty-hint">Start by adding your first book</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddBookAsync">Add your first book</MudButton>
                }
            </div>
        }
        else if (_displayedBooks.Count == 0)
        {
            <div class="library-empty">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 64px; opacity: 0.5;" />
                <MudText Typo="Typo.h6" Class="mt-4">No results for “@_shownSearch”</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2" OnClick="ClearSearch">Clear search</MudButton>
            </div>
        }
        else
        {
            @if (_currentViewMode == ViewMode.List)
            {
                <BooksListView Books="@_displayedBooks" OnActions="OpenBookActionsAsync" />
            }
            else
            {
                <BooksCoversView Books="@_displayedBooks" OnActions="OpenBookActionsAsync" />
            }
            @if (_isLoadingMore)
            {
                <div class="d-flex justify-center pa-4">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                </div>
            }
            <div id="scroll-sentinel"></div>
        }
    </div>
</div>

<ActionSheet Open="@(_openSheet == LibrarySheet.SortAndView)" AriaLabel="Sort and view" Title="Sort and view"
             Anchor="@_sheetAnchor" AlignEnd="true" OnClose="CloseSheet">
    <div class="action-sheet-section">Sort by</div>
    <ActionSheetItem Icon="@Icons.Material.Filled.ArrowDownward" Text="Newest first"
                     Selected="@(_currentSortOrder == BookSortOrder.IdDesc)" OnClick="() => ChooseSortOrderAsync(BookSortOrder.IdDesc)" />
    <ActionSheetItem Icon="@Icons.Material.Filled.ArrowUpward" Text="Oldest first"
                     Selected="@(_currentSortOrder == BookSortOrder.IdAsc)" OnClick="() => ChooseSortOrderAsync(BookSortOrder.IdAsc)" />
    <ActionSheetItem Icon="@Icons.Material.Filled.SortByAlpha" Text="Series & volume"
                     Selected="@(_currentSortOrder == BookSortOrder.SerieAndVolumeAsc)" OnClick="() => ChooseSortOrderAsync(BookSortOrder.SerieAndVolumeAsc)" />
    <div class="action-sheet-divider"></div>
    <div class="action-sheet-section">View</div>
    <ActionSheetItem Icon="@Icons.Material.Filled.GridView" Text="Covers" Description="Most books on screen"
                     Selected="@(_currentViewMode == ViewMode.Covers)" OnClick="() => ChooseViewMode(ViewMode.Covers)" />
    <ActionSheetItem Icon="@Icons.Material.Filled.ViewList" Text="List" Description="Title, series, authors, rating"
                     Selected="@(_currentViewMode == ViewMode.List)" OnClick="() => ChooseViewMode(ViewMode.List)" />
</ActionSheet>

<ActionSheet Open="@(_openSheet == LibrarySheet.AddBook)" AriaLabel="Add a book" Anchor="@_sheetAnchor" AlignEnd="true" OnClose="CloseSheet">
    <Header>
        <div class="add-book-sheet-heading">
            <h2>Add a book</h2>
            @if (_library is not null)
            {
                <div class="add-book-sheet-target">to @_library.Name</div>
            }
        </div>
        <div class="add-book-sheet-primary">
            <a href="@AddBookLinks.Scan(_libraryGuid)"><MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" />Scan the barcode</a>
        </div>
    </Header>
    <ChildContent>
        <ActionSheetItem Icon="@Icons.Material.Filled.Keyboard" Text="Type the ISBN" Description="When the barcode won’t scan" Href="@AddBookLinks.TypeIsbn(_libraryGuid)" />
        <ActionSheetItem Icon="@Icons.Material.Filled.EditNote" Text="Enter details manually" Description="No ISBN, or not found online" Href="@AddBookLinks.EnterDetails(_libraryGuid)" />
    </ChildContent>
</ActionSheet>

<ActionSheet Open="@(_openSheet == LibrarySheet.MoreActions)" AriaLabel="More actions"
             Anchor="@_sheetAnchor" AlignEnd="true" OnClose="CloseSheet">
    <ActionSheetItem Icon="@Icons.Material.Filled.Upload" Text="Import" Href="@($"/import?libraryId={LibraryId}")" />
    <ActionSheetItem Icon="@Icons.Material.Filled.DocumentScanner" Text="Find missing ISBNs"
                     Disabled="_isStartingIsbnScan" OnClick="FindMissingIsbnsAsync" />
</ActionSheet>

@if (_actionsBook is { } book)
{
    <ActionSheet Open="@(_openSheet == LibrarySheet.BookActions)" AriaLabel="@($"Actions for {book.Title}")"
                 Anchor="@_sheetAnchor" AlignEnd="@_sheetAlignEnd" OnClose="CloseSheet">
        <Header>
            <div class="book-actions-header">
                @if (!string.IsNullOrEmpty(book.ImageLink))
                {
                    <img src="@book.ImageLink" alt="" />
                }
                <div class="book-actions-heading">
                    <div class="book-actions-title">@book.Title</div>
                    <div class="book-actions-serie">@book.SerieAndVolume</div>
                </div>
            </div>
        </Header>
        <ChildContent>
            @if (IsDigital)
            {
                <ActionSheetItem Icon="@Icons.Material.Filled.MenuBook" Text="Read" Href="@($"/books/{book.Id}/read")" />
            }
            <ActionSheetItem Icon="@Icons.Material.Filled.Edit" Text="Edit" Href="@($"/books/{book.Id}/edit")" />
            <ActionSheetItem Icon="@Icons.Material.Filled.ManageSearch" Text="Import info from the web" Href="@($"/books/{book.Id}/find-details")" />
            @if (IsDigital)
            {
                <ActionSheetItem Icon="@Icons.Material.Filled.DocumentScanner" Text="Find ISBN" Href="@($"/books/{book.Id}/read?mode={Books.BookReader.IsbnSearchMode}")" />
                <ActionSheetItem Icon="@Icons.Material.Filled.Download" Text="Download CBZ" OnClick="() => DownloadBookAsync(book.Id)" />
            }
            <ActionSheetItem Icon="@Icons.Material.Filled.DriveFileMove" Text="Move to another library" OnClick="() => MoveAsync(book.Id)" />
            <div class="action-sheet-divider"></div>
            <ActionSheetItem Icon="@Icons.Material.Filled.Delete" Text="Delete" Danger="true" OnClick="() => DeleteAsync(book.Id)" />
        </ChildContent>
    </ActionSheet>
}
