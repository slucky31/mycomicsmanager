@rendermode InteractiveServer

@page "/libraries/add"

<PageTitle>New library — MyComicsManager</PageTitle>

<FormPage>
    <FormHeader Title="New library" Subtitle="Where your books are kept" BackHref="/libraries/list">
        <FormButton Variant="FormButtonVariant.Outlined" Href="/libraries/list">Cancel</FormButton>
        <FormButton Type="submit" Form="library-form" Icon="@Icons.Material.Filled.Add" Disabled="_isSaving">Create library</FormButton>
    </FormHeader>

    <LibraryForm FormId="library-form" Model="_model" IsNew="true" Errors="_errors" OnChanged="Revalidate" OnSubmit="SaveAsync">
        <Footer>
            <FormFooter>
                <FormButton Variant="FormButtonVariant.Outlined" Href="/libraries/list">Cancel</FormButton>
                <FormButton Type="submit" Icon="@Icons.Material.Filled.Add" Disabled="_isSaving">Create library</FormButton>
            </FormFooter>
        </Footer>
    </LibraryForm>
</FormPage>
