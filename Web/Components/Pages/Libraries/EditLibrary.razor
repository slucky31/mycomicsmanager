@rendermode InteractiveServer

@page "/libraries/{LibraryId}/edit"

<PageTitle>Edit library — MyComicsManager</PageTitle>

<FormPage>
    @if (_isLoading)
    {
        <FormHeader Title="Edit library" Subtitle="Loading…" BackHref="@LibraryHref" />
        <FormState Loading="true" Text="Loading the library…" />
    }
    else if (_model is null)
    {
        <FormHeader Title="Edit library" BackHref="/libraries/list" />
        <FormState Icon="@Icons.Material.Outlined.CollectionsBookmark" Title="Library not found" Text="This library does not exist or could not be loaded.">
            <FormButton Variant="FormButtonVariant.Outlined" Href="/libraries/list" Icon="@Icons.Material.Filled.ArrowBack">Back to libraries</FormButton>
        </FormState>
    }
    else
    {
        <FormHeader Title="Edit library" Subtitle="@_name" BackHref="@LibraryHref">
            <FormButton Variant="FormButtonVariant.Outlined" Href="@LibraryHref">Cancel</FormButton>
            <FormButton Type="submit" Form="library-form" Icon="@Icons.Material.Filled.Check" Disabled="_isSaving">Save changes</FormButton>
        </FormHeader>

        <LibraryForm FormId="library-form" Model="_model" Errors="_errors" OnChanged="Revalidate" OnSubmit="SaveAsync" BookCount="_bookCount" Covers="_covers" NameLocked="_nameLocked">
            <Footer>
                <FormFooter>
                    <FormButton Variant="FormButtonVariant.Outlined" Href="@LibraryHref">Cancel</FormButton>
                    <FormButton Type="submit" Icon="@Icons.Material.Filled.Check" Disabled="_isSaving">Save changes</FormButton>
                </FormFooter>
            </Footer>
        </LibraryForm>
    }
</FormPage>
