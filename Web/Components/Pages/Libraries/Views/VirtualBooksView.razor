@using Domain.Libraries
@using Web.Models

@* The books of a library, only those on screen rendered (#1344). *@
<VirtualGrid TItem="BookListItemViewModel" Source="Rows" ItemKey="KeyOf" RowSize="RowSize" RowClass="@(View == LibraryView.List ? "virtual-row-list" : null)"
             InitialItem="InitialBook" OnPositionChanged="OnPositionChanged" LoadErrorMessage="Failed to load books">
    <Probe>
        @if (View == LibraryView.List)
        {
            <BooksListView Books="NoBooks" OnActions="OnActions" />
        }
        else
        {
            <BooksCoversView Books="NoBooks" OnActions="OnActions" />
        }
    </Probe>
    <RowContent Context="row">
        @if (View == LibraryView.List)
        {
            <BooksListView Books="@row.Items" OnActions="OnActions" Selection="Selection" OnToggle="OnToggle" From="@From" />
        }
        else
        {
            <BooksCoversView Books="@row.Items" OnActions="OnActions" Selection="Selection" OnToggle="OnToggle" From="@From" />
        }
    </RowContent>
</VirtualGrid>
