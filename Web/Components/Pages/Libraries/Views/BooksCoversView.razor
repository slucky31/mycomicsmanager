@using Domain.Books
@using Web.Components.SharedComponents
@using Web.Models

<div class="covers-grid">
    @foreach (var book in Books)
    {
        <BookCover @key="book.Id" BookId="@book.Id" Title="@book.Title" Subtitle="@book.Serie" ImageLink="@book.ImageLink" Badge="@book.VolumeBadge"
                   Href="@ReturnLinks.Book(book.Id, From)" OnActions="() => OnActions.InvokeAsync(book)"
                   Selecting="@Selection.IsActive" Checked="@Selection.IsChecked(book)" OnToggle="() => OnToggle.InvokeAsync(book)">
            <CoverContent>
                @if (book.IsbnScanState != IsbnScanState.HasIsbn)
                {
                    <span class="cover-isbn-state">
                        <IsbnScanStateIcon State="@book.IsbnScanState" CandidateCount="@book.IsbnCandidateCount" OnDarkBackground="true" />
                    </span>
                }
            </CoverContent>
        </BookCover>
    }
</div>
