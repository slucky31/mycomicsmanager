@page "/feed-imports"

@using Application.FeedImports.Arbitrate
@using Application.FeedImports.Manage
@using Domain.FeedImports

<PageTitle>Feeds — MyComicsManager</PageTitle>

<PageLayout Title="Feeds" Icon="@Icons.Material.Filled.RssFeed">

    <div class="feed-imports-toolbar mb-4">
        <MudSelect T="FeedImportDecisionStatus?"
                   Label="Status"
                   Value="_statusFilter"
                   ValueChanged="OnStatusChangedAsync"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   AnchorOrigin="Origin.BottomCenter"
                   Class="feed-imports-status">
            <MudSelectItem T="FeedImportDecisionStatus?" Value="@((FeedImportDecisionStatus?)null)">All statuses</MudSelectItem>
            @foreach (var status in FeedImportDecisionViewModel.FilterableStatuses)
            {
                <MudSelectItem T="FeedImportDecisionStatus?" Value="@status">@FeedImportDecisionViewModel.GetStatusDisplay(status)</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string"
                      Label="Search"
                      Value="_searchTerm"
                      ValueChanged="OnSearchChangedAsync"
                      DebounceInterval="400"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Class="feed-imports-search" />

        @if (FeedImportService.IsSyncEnabled)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       Disabled="_isSyncRequested"
                       OnClick="SyncNowAsync"
                       Class="feed-imports-sync">
                Sync now
            </MudButton>
        }

        @if (_selectedDecisions.Count > 0)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="_isDeleting"
                       OnClick="DeleteSelectedAsync"
                       Class="feed-imports-delete-selection">
                Delete selection (@_selectedDecisions.Count)
            </MudButton>
        }
    </div>

    @if (!FeedImportService.IsSyncEnabled)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Miniflux sync is disabled (FeedImport:Enabled).
        </MudAlert>
    }

    <MudTable @ref="_table"
              T="FeedImportDecisionViewModel"
              ServerData="LoadServerDataAsync"
              Hover="true"
              Dense="true"
              MultiSelection="true"
              SelectOnRowClick="false"
              @bind-SelectedItems="_selectedDecisions"
              Breakpoint="Breakpoint.Sm"
              Class="feed-imports-table rounded-lg"
              Elevation="0">
        <HeaderContent>
            <MudTh Class="feed-imports-expand-col"></MudTh>
            <MudTh>Article</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh>Saved on</MudTh>
            <MudTh Class="feed-imports-delete-col"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="feed-imports-expand-col">
                <MudIconButton Icon="@(IsExpanded(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small"
                               OnClick="@(() => ToggleDetail(context.Id))"
                               aria-label="@(IsExpanded(context.Id) ? "Hide details" : "Show details")" />
            </MudTd>
            <MudTd DataLabel="Article">
                <div class="feed-imports-article">
                    <MudLink Href="@context.EntryUrl" Target="_blank" rel="noopener noreferrer nofollow" Typo="Typo.body2">@context.EntryTitle</MudLink>
                    @if (context.ItemDisplay is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">@context.ItemDisplay</MudText>
                    }
                    @if (context.ParsedDisplay is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.ParsedDisplay</MudText>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@context.StatusColor" Class="feed-imports-status-chip">@context.StatusDisplay</MudChip>
            </MudTd>
            <MudTd DataLabel="Reason">
                <MudText Typo="Typo.body2">@context.Reason</MudText>
            </MudTd>
            <MudTd DataLabel="Saved on">
                <MudText Typo="Typo.caption">@context.CreatedAtDisplay</MudText>
            </MudTd>
            <MudTd Class="feed-imports-delete-col">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               Disabled="@(!context.CanDelete || _isDeleting || IsBusy(context.Id))"
                               OnClick="@(() => DeleteAsync(context))"
                               aria-label="Delete decision" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (IsExpanded(context.Id))
            {
                <MudTr>
                    <td colspan="7" class="feed-imports-detail">
                        @if (context.ErrorDisplay is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@context.ErrorDisplay</MudAlert>
                        }
                        @if (context.CanResolveDuplicate)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                <div class="feed-imports-arbitration">
                                    <span>Probable duplicate: check the existing book before continuing.</span>
                                    @if (context.MatchedBookId is not null)
                                    {
                                        <MudLink Href="@($"/books/{context.MatchedBookId}")" Typo="Typo.body2">View the existing book</MudLink>
                                    }
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.NotDuplicate, null))">
                                        Not a duplicate
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.ConfirmDuplicate, null))">
                                        Confirm duplicate
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                        @if (context.CanChooseCandidate)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                <div class="feed-imports-arbitration">
                                    <span>Ambiguous links: keep the right file below, or state that all the links are the same file.</span>
                                    @if (context.Candidates.Count > 1)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                   Disabled="@IsBusy(context.Id)"
                                                   OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.MergeAsMirrors, null))">
                                            All these links are the same file
                                        </MudButton>
                                    }
                                </div>
                            </MudAlert>
                        }

                        @if (context.ManualActions.Any)
                        {
                            <div class="feed-imports-actions mb-3">
                                @if (context.ManualActions.CanForceDownload)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Download"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ApplyActionAsync(context.Id, FeedImportDecisionAction.ForceDownload))">
                                        Force download
                                    </MudButton>
                                }
                                @if (context.ManualActions.CanRetry)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Replay"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ApplyActionAsync(context.Id, FeedImportDecisionAction.Retry))">
                                        Retry
                                    </MudButton>
                                }
                                @if (context.ManualActions.CanCorrect)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Disabled="@(IsBusy(context.Id) || IsEditing(context.Id))"
                                               OnClick="@(() => StartCorrection(context))">
                                        Fix series / volume
                                    </MudButton>
                                }
                                @if (context.ManualActions.CanIgnore)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                               StartIcon="@Icons.Material.Filled.Block"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ApplyActionAsync(context.Id, FeedImportDecisionAction.Ignore))">
                                        Ignore
                                    </MudButton>
                                }
                            </div>
                        }
                        @if (IsEditing(context.Id))
                        {
                            <MudPaper Outlined="true" Class="feed-imports-correction pa-3 mb-3">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Fix the title parsing (the duplicate check runs again)</MudText>
                                <div class="feed-imports-correction-fields">
                                    <MudTextField T="string" Label="Series" @bind-Value="_correction!.Serie" Required="true"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                                    <MudNumericField T="int?" Label="Volume" @bind-Value="_correction.Volume" Min="0"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" Label="Title" @bind-Value="_correction.Title"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="300" />
                                </div>
                                <div class="feed-imports-actions mt-2">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="@(IsBusy(context.Id) || string.IsNullOrWhiteSpace(_correction.Serie))"
                                               OnClick="@(() => SaveCorrectionAsync(context.Id))">
                                        Save
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelCorrection">Cancel</MudButton>
                                </div>
                            </MudPaper>
                        }

                        <div class="feed-imports-detail-grid">
                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">Article</MudText>
                                <dl class="feed-imports-facts">
                                    <dt>Published on</dt>
                                    <dd>@context.PublishedAtDisplay</dd>
                                    <dt>Parsed as</dt>
                                    <dd>@(context.ParsedDisplay ?? "-")</dd>
                                    <dt>Decided by</dt>
                                    <dd>@context.DecidedByDisplay</dd>
                                </dl>
                                <MudButton Href="@context.EntryUrl" Target="_blank" rel="noopener noreferrer nofollow"
                                           Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-1">
                                    Open article
                                </MudButton>
                                @if (context.ImportPageUrl is not null)
                                {
                                    <MudButton Href="@context.ImportPageUrl"
                                               Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.Upload" Class="mt-1">
                                        Track import
                                    </MudButton>
                                }
                            </section>

                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">Files</MudText>
                                @if (context.Candidates.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No link extracted yet.</MudText>
                                }
                                @foreach (var candidate in context.Candidates)
                                {
                                    <div class="feed-imports-file">
                                        <div class="feed-imports-file-header">
                                            <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" />
                                            <span class="feed-imports-file-name">@candidate.DisplayName</span>
                                            @if (candidate.SizeDisplay is not null)
                                            {
                                                <span class="feed-imports-file-size">@candidate.SizeDisplay</span>
                                            }
                                            @if (context.CanChooseCandidate)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           Disabled="@IsBusy(context.Id)"
                                                           OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.KeepCandidate, candidate.Index))">
                                                    Keep this link
                                                </MudButton>
                                            }
                                        </div>
                                        <div class="feed-imports-mirrors">
                                            @foreach (var mirror in candidate.Mirrors)
                                            {
                                                <a class="@(mirror.IsChosen ? "feed-imports-mirror is-chosen" : "feed-imports-mirror")" href="@mirror.Url"
                                                   target="_blank" rel="noopener noreferrer nofollow"
                                                   title="@(mirror.IsChosen ? "Mirror used for the download" : null)">
                                                    <MudIcon Icon="@(mirror.IsChosen ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.OpenInNew)" Size="Size.Small" />
                                                    @mirror.Host
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </section>

                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">History</MudText>
                                <ol class="feed-imports-timeline">
                                    @foreach (var evt in context.Events)
                                    {
                                        <li>
                                            <span class="feed-imports-timeline-date">@evt.OccurredAtDisplay · @evt.DecidedByDisplay</span>
                                            <span class="feed-imports-timeline-status">@evt.StatusDisplay</span>
                                            <span class="feed-imports-timeline-text">@evt.Description</span>
                                        </li>
                                    }
                                </ol>
                            </section>
                        </div>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary">No import decisions.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText Typo="Typo.body2">Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@s_pageSizeOptions" RowsPerPageString="Rows per page:" />
        </PagerContent>
    </MudTable>

</PageLayout>
