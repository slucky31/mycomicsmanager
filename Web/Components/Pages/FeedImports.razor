@page "/feed-imports"

@using Application.FeedImports.Arbitrate
@using Domain.FeedImports

<PageTitle>Feeds — MyComicsManager</PageTitle>

<PageLayout Title="Feeds" Icon="@Icons.Material.Filled.RssFeed">

    <div class="feed-imports-toolbar mb-4">
        <MudSelect T="FeedImportDecisionStatus?"
                   Label="Statut"
                   Value="_statusFilter"
                   ValueChanged="OnStatusChangedAsync"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   AnchorOrigin="Origin.BottomCenter"
                   Class="feed-imports-status">
            <MudSelectItem T="FeedImportDecisionStatus?" Value="@((FeedImportDecisionStatus?)null)">Tous les statuts</MudSelectItem>
            @foreach (var status in FeedImportDecisionViewModel.FilterableStatuses)
            {
                <MudSelectItem T="FeedImportDecisionStatus?" Value="@status">@FeedImportDecisionViewModel.GetStatusDisplay(status)</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string"
                      Label="Rechercher"
                      Value="_searchTerm"
                      ValueChanged="OnSearchChangedAsync"
                      DebounceInterval="400"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Class="feed-imports-search" />

        @if (FeedImportService.IsSyncEnabled)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       Disabled="_isSyncRequested"
                       OnClick="SyncNowAsync"
                       Class="feed-imports-sync">
                Synchroniser maintenant
            </MudButton>
        }
    </div>

    @if (!FeedImportService.IsSyncEnabled)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            La synchronisation Miniflux est désactivée (FeedImport:Enabled).
        </MudAlert>
    }

    <MudTable @ref="_table"
              T="FeedImportDecisionViewModel"
              ServerData="LoadServerDataAsync"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Class="feed-imports-table rounded-lg"
              Elevation="0">
        <HeaderContent>
            <MudTh Class="feed-imports-expand-col"></MudTh>
            <MudTh>Article</MudTh>
            <MudTh>Statut</MudTh>
            <MudTh>Raison</MudTh>
            <MudTh>Enregistré le</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="feed-imports-expand-col">
                <MudIconButton Icon="@(IsExpanded(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small"
                               OnClick="@(() => ToggleDetail(context.Id))"
                               aria-label="@(IsExpanded(context.Id) ? "Masquer le détail" : "Afficher le détail")" />
            </MudTd>
            <MudTd DataLabel="Article">
                <div class="feed-imports-article">
                    <MudLink Href="@context.EntryUrl" Target="_blank" rel="noopener noreferrer nofollow" Typo="Typo.body2">@context.EntryTitle</MudLink>
                    @if (context.ItemDisplay is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">@context.ItemDisplay</MudText>
                    }
                    @if (context.ParsedDisplay is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.ParsedDisplay</MudText>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Statut">
                <MudChip T="string" Size="Size.Small" Color="@context.StatusColor" Class="feed-imports-status-chip">@context.StatusDisplay</MudChip>
            </MudTd>
            <MudTd DataLabel="Raison">
                <MudText Typo="Typo.body2">@context.Reason</MudText>
            </MudTd>
            <MudTd DataLabel="Enregistré le">
                <MudText Typo="Typo.caption">@context.CreatedAtDisplay</MudText>
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (IsExpanded(context.Id))
            {
                <MudTr>
                    <td colspan="5" class="feed-imports-detail">
                        @if (context.ErrorDisplay is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@context.ErrorDisplay</MudAlert>
                        }
                        @if (context.CanResolveDuplicate)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                <div class="feed-imports-arbitration">
                                    <span>Doublon probable : vérifiez le livre déjà présent avant de continuer.</span>
                                    @if (context.MatchedBookId is not null)
                                    {
                                        <MudLink Href="@($"/books/{context.MatchedBookId}")" Typo="Typo.body2">Voir le livre déjà présent</MudLink>
                                    }
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.NotDuplicate, null))">
                                        Pas un doublon
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                               Disabled="@IsBusy(context.Id)"
                                               OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.ConfirmDuplicate, null))">
                                        Confirmer le doublon
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                        @if (context.CanChooseCandidate)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                <div class="feed-imports-arbitration">
                                    <span>Liens ambigus : gardez le bon fichier ci-dessous, ou indiquez que tous les liens sont le même fichier.</span>
                                    @if (context.Candidates.Count > 1)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                   Disabled="@IsBusy(context.Id)"
                                                   OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.MergeAsMirrors, null))">
                                            Tous ces liens sont le même fichier
                                        </MudButton>
                                    }
                                </div>
                            </MudAlert>
                        }

                        <div class="feed-imports-detail-grid">
                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">Article</MudText>
                                <dl class="feed-imports-facts">
                                    <dt>Publié le</dt>
                                    <dd>@context.PublishedAtDisplay</dd>
                                    <dt>Lu comme</dt>
                                    <dd>@(context.ParsedDisplay ?? "-")</dd>
                                    <dt>Décidé par</dt>
                                    <dd>@context.DecidedByDisplay</dd>
                                </dl>
                                <MudButton Href="@context.EntryUrl" Target="_blank" rel="noopener noreferrer nofollow"
                                           Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-1">
                                    Ouvrir l'article
                                </MudButton>
                            </section>

                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">Fichiers</MudText>
                                @if (context.Candidates.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Aucun lien extrait pour l'instant.</MudText>
                                }
                                @foreach (var candidate in context.Candidates)
                                {
                                    <div class="feed-imports-file">
                                        <div class="feed-imports-file-header">
                                            <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" />
                                            <span class="feed-imports-file-name">@candidate.DisplayName</span>
                                            @if (candidate.SizeDisplay is not null)
                                            {
                                                <span class="feed-imports-file-size">@candidate.SizeDisplay</span>
                                            }
                                            @if (context.CanChooseCandidate)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           Disabled="@IsBusy(context.Id)"
                                                           OnClick="@(() => ResolveAsync(context.Id, FeedImportArbitrationAction.KeepCandidate, candidate.Index))">
                                                    Garder ce lien
                                                </MudButton>
                                            }
                                        </div>
                                        <div class="feed-imports-mirrors">
                                            @foreach (var mirror in candidate.Mirrors)
                                            {
                                                <a class="feed-imports-mirror" href="@mirror.Url" target="_blank" rel="noopener noreferrer nofollow">
                                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                                    @mirror.Host
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </section>

                            <section class="feed-imports-detail-section">
                                <MudText Typo="Typo.subtitle2" Class="feed-imports-detail-title">Historique</MudText>
                                <ol class="feed-imports-timeline">
                                    @foreach (var evt in context.Events)
                                    {
                                        <li>
                                            <span class="feed-imports-timeline-date">@evt.OccurredAtDisplay · @evt.DecidedByDisplay</span>
                                            <span class="feed-imports-timeline-status">@evt.StatusDisplay</span>
                                            <span class="feed-imports-timeline-text">@evt.Description</span>
                                        </li>
                                    }
                                </ol>
                            </section>
                        </div>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Aucune décision d'import.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText Typo="Typo.body2">Chargement...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@s_pageSizeOptions" RowsPerPageString="Par page :" />
        </PagerContent>
    </MudTable>

</PageLayout>
