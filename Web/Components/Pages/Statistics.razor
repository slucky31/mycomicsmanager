@page "/statistics"

@using Web.Components.Pages.Books

<PageTitle>Statistics — MyComicsManager</PageTitle>

<div class="stats-page">
    <header class="stats-bar">
        <h1>Statistics</h1>
        <LibrarySelect Id="stats-library" Libraries="_libraries" Value="_selectedLibraryId" ValueChanged="OnLibraryChangedAsync" AllLabel="All libraries" Compact="true" />
    </header>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="stats-loading" />
    }

    @if (_statistics is { } stats)
    {
        <div class="stats-content">
            <section class="stats-card stats-headline">
                @if (stats.HasBooks)
                {
                    <div class="stats-headline-total"><span class="stats-headline-number">@stats.TotalBooks</span> <span>@stats.BooksUnit</span></div>
                    <div class="stats-headline-read"><strong>@stats.ReadBooks read</strong> · @stats.UnreadBooks unread</div>
                    <div class="stats-progress" aria-hidden="true"><div class="stats-progress-value" style="@($"width: {stats.ReadPercent}%;")"></div></div>
                    <div class="stats-headline-percent">@stats.ReadPercent% of your collection is read</div>
                }
                else
                {
                    <div class="stats-headline-total"><span class="stats-headline-number">0</span> <span>books</span></div>
                    <div class="stats-headline-percent">No books yet. Add books to a library to see your statistics.</div>
                }
            </section>

            <div class="stats-tiles">
                @foreach (var tile in stats.Tiles)
                {
                    <div class="stats-card stats-tile">
                        <div class="stats-tile-label"><MudIcon Icon="@tile.Icon" />@tile.Label</div>
                        <div class="stats-tile-value">@tile.Value<span class="stats-tile-suffix">@tile.Suffix</span></div>
                    </div>
                }
            </div>
            <section class="stats-card stats-chart-card">
                <div class="stats-section-head">
                    <h2>Readings per month</h2>
                    <span>@stats.Chart.PeriodLabel · @stats.Chart.Total</span>
                </div>
                <div class="stats-chart" role="img" aria-label="@stats.Chart.AriaLabel">
                    <div class="stats-chart-plot" aria-hidden="true">
                        @for (var i = stats.Chart.AxisTicks.Count - 1; i >= 0; i--)
                        {
                            var tick = stats.Chart.AxisTicks[i];
                            <div class="stats-chart-grid" style="@($"bottom: {i * 50}%;")"><span>@tick</span></div>
                        }
                        <div class="stats-chart-bars">
                            @foreach (var bar in stats.Chart.Bars)
                            {
                                <div class="stats-chart-column" title="@($"{bar.Month}: {bar.Count}")">
                                    @if (bar.Count > 0)
                                    {
                                        <div class="stats-chart-bar" style="@($"height: {bar.HeightPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%;")">
                                            @if (bar.IsPeak)
                                            {
                                                <span class="stats-chart-peak">@bar.Count</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="stats-chart-months" aria-hidden="true">
                        @foreach (var bar in stats.Chart.Bars)
                        {
                            <span>@bar.Initial</span>
                        }
                    </div>
                </div>
            </section>

        </div>
    }
</div>
