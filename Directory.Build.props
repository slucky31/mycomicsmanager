<Project>
  <PropertyGroup>
    <!-- Single source of truth for the version; updated by Versionize in the release job. -->
    <Version>10.11.2</Version>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The app has no localized resources of its own; drop the satellite resource assemblies
         (ca, de, es, fr, zh, ...) that NuGet dependencies ship for every culture, so they don't
         get published into the Docker image. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
