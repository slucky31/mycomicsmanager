<Project>
  <PropertyGroup>
    <!-- Single source of truth for the version; updated by Versionize in the release job. -->
    <Version>10.81.1</Version>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The app has no localized resources of its own; drop the satellite resource assemblies
         (ca, de, es, fr, zh, ...) that NuGet dependencies ship for every culture, so they don't
         get published into the Docker image. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Report every known vulnerability (NU1901 to NU1904) at restore, direct and transitive
         packages alike. The CI builds with -warnaserror, so a vulnerable package fails the PR. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- APIs banned by the coding rules of CLAUDE.md (RS0030, Microsoft.CodeAnalysis.BannedApiAnalyzers). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" Visible="false" />
  </ItemGroup>
  <!-- Production code reads the time from an injected TimeProvider (FakeTimeProvider in the tests); the tests
       may still build their data from the system clock. -->
  <ItemGroup Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/tests/'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Production.txt" Link="BannedSymbols.Production.txt" Visible="false" />
  </ItemGroup>
</Project>
